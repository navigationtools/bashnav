tidal_gate|station=ticon/portsmouth-ptm-gbr-bodc date=2025-05-24 t=11:00 track=255 streams=255:2.0,255:1.6,255:0.9,255:0.2,075:0.6,075:1.5,075:2.2,075:2.0,075:1.2,075:0.3,255:0.5,255:1.3,255:1.9|best=2.000000 bestpage=-6 along=-0.915000 n=2 o1=-20 s1=356 ok1=1 sk1=1 o2=724 s2=1104 ok2=1 sk2=1 state=shut left=64
