tidal_gate|hw=14:32 opens=5 shuts=-1 t=17:00 dist=22 sog=7|n=2 o1=427 s1=812 ok1=1 sk1=1 o2=1172 s2=1557 ok2=1 sk2=1 state=shut left=152 p=189 lv1=238 lb1=623 lv2=983 lb2=1368
# the pilot book, both hours on one tide
tidal_gate|hw=14:32 opens=-1 shuts=5 t=15:00|n=1 o1=812 s1=1172 ok1=1 sk1=1 state=open left=272
# half hours, the next high water given, over midnight
tidal_gate|hw=22:50 hw2=11:22 opens=4.5 shuts=-1.5 t=02:00 dist=6 sog=4.5|n=2 o1=895 s1=1280 ok1=1 sk1=1 o2=1640 s2=2032 ok2=1 sk2=1 state=shut left=80 p=80 lv1=815 lb1=1200 lv2=1560 lb2=1952
# Portsmouth's own high waters, as `tides today` prints them at BODC's record
# (Larry, AED: the examples use it, as the course does): 20:17 the day before, 08:41, 21:09
tidal_gate|station=ticon/portsmouth-ptm-gbr-bodc date=2025-05-24 t=11:00 opens=5 shuts=-1|n=2 o1=77 s1=461 ok1=1 sk1=1 o2=821 s2=1209 ok2=1 sk2=1 state=shut left=161
