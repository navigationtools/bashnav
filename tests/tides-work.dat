tidal_gate|hw=01:10 opens=-3 shuts=2 t=23:30|n=1 o1=-110 s1=190 ok1=1 sk1=1 state=open left=220
# tides only 11 h 30 min apart: the next tide's first page falls before this tide's last
tidal_gate|hw=14:32 hw2=02:02 track=255 streams=255:2.0,255:1.6,255:0.9,255:0.2,075:0.6,075:1.5,075:2.2,075:2.0,075:1.2,075:0.3,255:0.5,255:1.3,255:1.9 t=21:00|best=2.000000 bestpage=-6 along=1.620000 n=2 o1=330 s1=707 ok1=1 sk1=1 o2=1075 s2=1397 ok2=1 sk2=1 state=open left=137
