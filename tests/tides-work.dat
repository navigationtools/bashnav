setdrift|start=50.4630,-2.4550 co=250 stw=6.5 hours=2 fix=50.3660,-2.8260|set=235.073900 drift=2.399461 rate=1.199731
secondary|hw=10:52 hwh=4.39 lw=04:30 lwh=1.50 mhws=5.5 mhwn=4.4 mlwn=2.2 mlws=0.8 dhws=-0.2 dhwn=-0.1 dlwn=0.0 dlws=0.1 thw1=0000 tdhw1=20 thw2=0600 tdhw2=10 tlw1=0000 tdlw1=5 tlw2=0600 tdlw2=25|Htime=670 Hheight=4.290909 Ltime=290 Lheight=1.55
# ---- tidal_gate: every expected value is from tests/tides-work-ref.py, which finds the
# turn by bisection and the stream along the track by a dot product.  Times are minutes
# from the midnight of the high water's day.
# the atlas, all thirteen pages: the help example
tidal_gate|hw=14:32 track=255 streams=075:2.2,078:2.6,080:2.0,085:0.9,250:0.4,255:1.5,258:2.4,260:2.7,258:2.1,255:1.0,080:0.3,078:1.4,076:2.1 t=17:00 dist=22 sog=7|best=2.690000 bestpage=1 along=1.586667 n=1 o1=733 s1=1098 ok1=1 sk1=1 state=open left=78 p=189 lv1=544 lb1=909
# open across LOW water: a window from the tide before, and one into the next
tidal_gate|hw=14:32 track=255 streams=255:2.0,255:1.6,255:0.9,255:0.2,075:0.6,075:1.5,075:2.2,075:2.0,075:1.2,075:0.3,255:0.5,255:1.3,255:1.9 t=20:00|best=2.000000 bestpage=-6 along=1.580000 n=2 o1=330 s1=707 ok1=1 sk1=1 o2=1075 s2=1452 ok2=1 sk2=1 state=open left=252
# the same with the next high water given, 12 h 40 min on: only the last shutting moves
tidal_gate|hw=14:32 hw2=03:12 track=255 streams=255:2.0,255:1.6,255:0.9,255:0.2,075:0.6,075:1.5,075:2.2,075:2.0,075:1.2,075:0.3,255:0.5,255:1.3,255:1.9 t=20:00|best=2.000000 bestpage=-6 along=1.580000 n=2 o1=330 s1=707 ok1=1 sk1=1 o2=1075 s2=1467 ok2=1 sk2=1 state=open left=267
# a knot of foul stream accepted: the window widens
tidal_gate|hw=14:32 track=255 streams=075:2.2,078:2.6,080:2.0,085:0.9,250:0.4,255:1.5,258:2.4,260:2.7,258:2.1,255:1.0,080:0.3,078:1.4,076:2.1 foul=1.0 t=11:45|best=2.690000 bestpage=1 along=-0.610500 n=1 o1=686 s1=1150 ok1=1 sk1=1 state=open left=445
# four pages from HW +2: it opens on them, and when it shuts is not on them
tidal_gate|hw=23:40 track=090 streams=270:1.5,275:0.6,090:0.5,092:1.8 from=2 foul=0.8 t=03:10|best=1.800000 bestpage=5 along=-0.050000 n=1 o1=1587 s1=1720 ok1=1 sk1=0 state=open
# the same, asked about a time off the pages: not known
tidal_gate|hw=23:40 track=090 streams=270:1.5,275:0.6,090:0.5,092:1.8 from=2 t=08:00|best=1.800000 bestpage=5 n=1 o1=1633 s1=1720 ok1=1 sk1=0 state=unknown
# foul on every page given
tidal_gate|hw=14:32 track=075 streams=250:1.0,255:2.0,260:1.5 from=-1|best=-1.000000 bestpage=-1 n=0
# fair on every page given
tidal_gate|hw=14:32 track=255 streams=250:1.0,255:2.0,260:1.5 from=-1 dist=10 sog=5|best=2.000000 bestpage=0 n=1 o1=812 s1=932 ok1=0 sk1=0 p=120
