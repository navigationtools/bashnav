function rt_whatif_figure(   w, h, i, n, k, s, a, b, c, t){
  rt_init()
  w = 66; h = 11
  gclear(w, h)
  FIGNAME = "rtwhatif"
  gputsc(0, 0, "The 2025 Myth of Malham, routed three times by bashnav's router", C_ACC)
  gputsc(2, 0, "wind    = to the Eddystone        # the run home          in all", C_DIM)
  for(i = 1; i <= RT_RUNN; i++){
    s = ""; n = int(RT_RUN[4*i-2] + 0.5)
    for(k = 0; k < n; k++) s = s "="
    gputsc(2 + i, 0, sprintf("x %.1f", RT_RUN[4*i-3]), "")
    gputsc(2 + i, 8, s, C_DIM)
    t = ""; n = int(RT_RUN[4*i-1] - RT_RUN[4*i-2] + 0.5)
    for(k = 0; k < n; k++) t = t "#"
    gputsc(2 + i, 8 + length(s), t, C_ACC)
    gputsc(2 + i, 58, rt_hm(RT_RUN[4*i-1]), "")
    a = a (i > 1 ? (i < RT_RUNN ? ", " : " and ") : "") sprintf("%.1f", RT_RUN[4*i-2])
    b = b (i > 1 ? (i < RT_RUNN ? ", " : " and ") : "") RT_RUN[4*i]
    c = c (i > 1 ? (i < RT_RUNN ? ", " : " and ") : "") sprintf("%.1f", RT_RUN[4*i-1] - RT_RUN[4*i-2])
  }
  gputsc(7, 0, "To the Eddystone: " a " hours. She tacked for Start", "")
  gputsc(8, 0, "Point at " b " UTC: the same call each time.", C_ACC)
  gputsc(9, 0, "The run home: " c " hours. The clock moved.", "")
  return 0
}
# =====================================================================
#  deck-log -- the weather reasoning.
#
#  EVERY RULE SHOWS ITS WORKING.  A forecast handed over without its
#  reasoning teaches nothing; the explanation is the product.
#
#  And it can only ever be as good as the log behind it: this reasons
#  from observations the user made, and says so.  With no network there
#  is no model, no GRIB and no chart.  What there is, is the one
#  category of weather data that is never wrong.
# =====================================================================

function wx_num(s){ if(s=="" || s=="-" || s=="/") return -9999; return s+0 }
function wx_has(x){ return (x>-9000) }

#  Angle difference on the circle.  350 against 010 is 20 degrees, not
#  340, and getting this wrong would misreport every veer near north.
function wx_d180(a){ while(a>180) a-=360; while(a<-180) a+=360; return a }

#  Minutes between two of our timestamps.  Days from a civil date, so
#  month ends and leap years come out right without a date library.
function wx_mins(ts,   y,mo,d,h,mi,a,jd){
  y=substr(ts,1,4)+0; mo=substr(ts,6,2)+0; d=substr(ts,9,2)+0
  h=substr(ts,12,2)+0; mi=substr(ts,15,2)+0
  a = int((14-mo)/12); y2 = y + 4800 - a; m2 = mo + 12*a - 3
  jd = d + int((153*m2+2)/5) + 365*y2 + int(y2/4) - int(y2/100) + int(y2/400) - 32045
  return jd*1440 + h*60 + mi
}

#  Load the observation history: the nav and wx records, newest last.
#
#  THE LATITUDE IS CARRIED.  Only a deck entry has a position; a weather
#  observation taken on its own (deck-log has a form for exactly that) has
#  none.  Until weather 1.0.5 such a reading kept an empty latitude, and
#  an empty latitude was read as the EQUATOR and as NORTH: the daily tide
#  was taken off at its full tropical 1.4 hPa, which at 50 degrees is four
#  times too much, enough to turn a definite fall into "near steady".
#  Found while drawing the barograph, whose wave needs the same latitude.
#  So a reading without a position takes the last one logged before it,
#  and readings before the first position take that first one.  With no
#  latitude anywhere in the log it stays empty, and the rules then say the
#  tide is not allowed for rather than guess (see wx_tideok).
function wx_load(logfile,   i, n, lastlat, firstlat){
  WN=0; lastlat=""; firstlat=""
  lg_read(logfile, "")
  for(i=1;i<=LG_N;i++){
    if(!lg_at(i)) continue
    if(LG_TYPE!="nav" && LG_TYPE!="wx") continue
    #  merge records that share a timestamp: a nav entry and the wx
    #  entry taken with it are one observation
    if(WN>0 && WT[WN]==LG_TS) n=WN; else { WN++; n=WN; WT[n]=LG_TS
      WDIR[n]=-9999; WSPD[n]=-9999; WP[n]=-9999; WTEND[n]=""
      WAIR[n]=-9999; WDEW[n]=-9999; WSEA[n]=-9999; WCLD[n]=-9999
      WSWP[n]=-9999; WSWD[n]=-9999; WLAT[n]=lastlat
      WSST[n]=-9999; WSWH[n]=-9999
      WCL[n]=-1; WCM[n]=-1; WCH[n]=-1; WVIS[n]=-1 }
    if(LG["wdir"]!="") WDIR[n]=wx_num(LG["wdir"])
    if(LG["wspd"]!="") WSPD[n]=wx_num(LG["wspd"])
    if(LG["mslp"]!="") WP[n]  =wx_num(LG["mslp"])
    if(LG["ptend"]!="" && LG["ptend"]!="-") WTEND[n]=LG["ptend"]
    if(LG["airt"]!="") WAIR[n]=wx_num(LG["airt"])
    if(LG["dewp"]!="") WDEW[n]=wx_num(LG["dewp"])
    if(LG["seat"]!="") WSEA[n]=wx_num(LG["seat"])
    if(LG["cloud"]!="") WCLD[n]=wx_num(LG["cloud"])
    if(LG["swper"]!="") WSWP[n]=wx_num(LG["swper"])
    if(LG["swdir"]!="") WSWD[n]=wx_num(LG["swdir"])
    #  the sea state as logged (the Douglas code, 0 to 9) and the swell's
    #  height.  WSEA above is the sea TEMPERATURE, which took the name
    #  first; the state of the sea is WSST.  Until weather 1.0.7 neither
    #  of these was read, so a sea-state forecast could not be scored.
    if(LG["sea"] ~ /^[0-9]$/) WSST[n]=LG["sea"]+0
    if(LG["swht"]!="") WSWH[n]=wx_num(LG["swht"])
    if(LG["cl"]!="" && LG["cl"]!="-" && LG["cl"]!="/") WCL[n]=LG["cl"]+0
    if(LG["cm"]!="" && LG["cm"]!="-" && LG["cm"]!="/") WCM[n]=LG["cm"]+0
    if(LG["ch"]!="" && LG["ch"]!="-" && LG["ch"]!="/") WCH[n]=LG["ch"]+0
    if(LG["vis"]!="" && LG["vis"]!="-" && LG["vis"]!="/") WVIS[n]=LG["vis"]+0
    if(LG["lat"]!=""){ WLAT[n]=LG["lat"]; lastlat=LG["lat"]; if(firstlat=="") firstlat=LG["lat"] }
  }
  for(i=1;i<=WN && WLAT[i]=="";i++) WLAT[i]=firstlat
  return WN
}

#  Northern or southern, from a latitude written as "41 14.0N" or "-33.9"
function wx_north(s){
  if(s=="") return 1
  if(s ~ /[Ss]$/) return 0
  if(substr(s,1,1)=="-") return 0
  return 1
}
function wx_latdeg(s,   x){
  x = s+0; if(x<0) x=-x
  return x
}

# ---------------------------------------------------------------------
#  The atmospheric tide.
#
#  Solar heating drives a wave that travels westward with the sun, and
#  it is on every barometer.  In the tropics the glass falls two to
#  three millibars between mid-morning and mid-afternoon EVERY DAY IN
#  PERFECT WEATHER, and a sailor who does not know that reads a routine
#  afternoon fall as a system approaching.
#
#  Dominantly SEMIdiurnal - twice a day, not once.  Maxima near 1000
#  and 2200 local, minima near 0400 and 1600.  Amplitude about 1.4 hPa
#  in the tropics, falling steeply with latitude.
#
#  So the correction is applied BEFORE anything is said about tendency,
#  and it is said out loud.
# ---------------------------------------------------------------------
function wx_tide(ts, lon, lat,   utch, solar, amp, la){
  utch = substr(ts,12,2)+0 + (substr(ts,15,2)+0)/60.0
  solar = utch + (lon+0)/15.0
  while(solar<0) solar+=24; while(solar>=24) solar-=24
  la = wx_latdeg(lat)
  amp = 1.4 * cos(la*3.14159265/180.0)^3
  if(amp<0) amp = -amp
  #  maxima near 1000 and 2200 local: a cosine of period 12 h peaking there
  return amp * cos(2*3.14159265*(solar-10.0)/12.0)
}

#  The tide can be allowed for only when we know where the sun is (the
#  longitude) and how big the tide is here (the latitude of both readings).
function wx_tideok(lon, lat1, lat2){ return (lon!="" && lat1!="" && lat2!="") }

# ---------------------------------------------------------------------
#  The tendency, in the four words the barograph uses.  ONE RULE, used by
#  the report's sentence, by the table of the glass and by the page's
#  barograph, so the three cannot disagree: the change per three hours,
#  with the daily tide allowed for where it can be.
#     3.6 hPa or more down   falling fast
#     1.6 or more down       falling
#     1.6 or more up         rising
#     otherwise              steady
#  THE MET OFFICE'S BANDS (weather 1.0.13; Larry, TAVL, 18 November 2026).
#  The Met Office's marine glossary, "Pressure tendency in station
#  reports": slowly 0.1 to 1.5 hPa in three hours, plain rising or falling
#  1.6 to 3.5, quickly 3.6 to 6.0, very rapidly over 6.0.  "Steady" here is
#  their slowly and less, "falling fast" their quickly and more.  The watch
#  (WeatherGlass, CelestialGlass) uses the same 1.6, and 3.6 and 6.0 for its
#  pressure figure's colours, so the wrist and bashnav read one log alike.
#  Was 1.5 and 3.0.  The same numbers are in wx.js band() and in the deck
#  log's src/decklog/wx.awk; docs/SOURCES.md has the source.
#  THE WORD FOLLOWS THE FIGURE PRINTED.  The rate is graded as the table
#  prints it, to a tenth (as the Met Office's bands are written), so a
#  line never reads "+1.6 hPa in 3 h" beside "steady" because the rate
#  was 1.57.  The table's figure is c/d*3 printed "%+.1f"; the same
#  expression and the same printf are used here.  wx.js does the same
#  with cfixed(), its copy of C's printf.
# ---------------------------------------------------------------------
function wx_band(corr, dt,   r){
  if(dt<=0) return "steady"
  r = sprintf("%.1f", corr/dt*3.0) + 0
  if(r <= -3.6) return "falling fast"
  if(r <= -1.6) return "falling"
  if(r >=  1.6) return "rising"
  return "steady"
}

# ---------------------------------------------------------------------
#  THE GLASS (W04; weather 1.0.5; Larry, AOI and AOQ, 17 November 2026).
#  The pressures of the last 24, 48 or 72 hours of the log, ending at the
#  latest one, as a barograph.  The page draws it: one bold trace, each
#  stretch coloured and weighted by its tendency, a strip of the same
#  words beneath, and behind it the daily tide alone as a wave from the
#  first reading.  The terminal prints the same thing as a table: one
#  line for each run of readings in the same tendency.
#
#  wx_glass_build fills, for the readings in the window:
#     GLN       how many          GLI[i]  which observation
#     GLM[i]    its time, minutes
#     GLC[i]    the change from the reading before, tide allowed for
#     GLD[i]    the hours between them      GLB[i]  the tendency word
#     GLTIDE    1 if the tide could be allowed for
#     GLAMP     the tide's size here, hPa each way: 1.4 cos^3(latitude)
# ---------------------------------------------------------------------
function wx_mon(m){ return substr("JanFebMarAprMayJunJulAugSepOctNovDec", 3*m-2, 3) }
function wx_day(ts){ return sprintf("%d %s", substr(ts,9,2)+0, wx_mon(substr(ts,6,2)+0)) }
function wx_glass_build(lon, hours,   i, e, t1, m, dp, la){
  GLN=0; GLTIDE=0; GLAMP=0
  for(e=WN; e>=1; e--) if(wx_has(WP[e])) break
  if(e<1) return 0
  t1 = wx_mins(WT[e]) - hours*60
  for(i=1;i<=e;i++){
    if(!wx_has(WP[i])) continue
    m = wx_mins(WT[i]); if(m < t1) continue
    GLN++; GLI[GLN]=i; GLM[GLN]=m
  }
  GLTIDE = wx_tideok(lon, WLAT[e], WLAT[e]) ? 1 : 0
  if(GLTIDE){ la = wx_latdeg(WLAT[e]); GLAMP = 1.4 * cos(la*3.14159265/180.0)^3; if(GLAMP<0) GLAMP=-GLAMP }
  for(i=2;i<=GLN;i++){
    GLD[i] = (GLM[i]-GLM[i-1])/60.0
    dp = WP[GLI[i]] - WP[GLI[i-1]]
    if(GLTIDE) dp = dp - (wx_tide(WT[GLI[i]], lon, WLAT[GLI[i]]) - wx_tide(WT[GLI[i-1]], lon, WLAT[GLI[i-1]]))
    GLC[i] = dp
    GLB[i] = wx_band(dp, GLD[i])
  }
  return GLN
}
function wx_glass(lon, hours,   i, j, c, d, lab, day){
  if(wx_glass_build(lon, hours) < 2) return 0
  print ""
  wx_say(sprintf("The glass, last %d hours:", hours))
  day = substr(WT[GLI[1]],1,10)
  wx_say(sprintf("   %-17s%7.1f", wx_day(WT[GLI[1]]) " " substr(WT[GLI[1]],12,5), WP[GLI[1]]))
  i=2
  while(i<=GLN){
    j=i; c=GLC[i]; d=GLD[i]
    while(j+1<=GLN && GLB[j+1]==GLB[i]){ j++; c+=GLC[j]; d+=GLD[j] }
    lab = "to " substr(WT[GLI[j]],12,5)
    if(substr(WT[GLI[j]],1,10)!=day){ lab = "to " wx_day(WT[GLI[j]]) " " substr(WT[GLI[j]],12,5); day = substr(WT[GLI[j]],1,10) }
    wx_say(sprintf("   %-17s%7.1f   %-14s%+.1f hPa in 3 h", lab, WP[GLI[j]], GLB[i], (d>0 ? c/d*3 : 0)))
    i=j+1
  }
  if(GLTIDE)       wx_why(sprintf("the daily tide alone is %.1f hPa each way here, and is allowed for", GLAMP))
  else if(lon=="") wx_why("no longitude set, so the daily tide is not allowed for")
  else             wx_why("no latitude in the log yet, so the daily tide is not allowed for")
  return 1
}

# ---------------------------------------------------------------------
#  THE SEA AGAINST THE WIND (W09; weather 1.0.7).  Larry's rulings of
#  17 November 2026:
#     AOU  the curve is a public source's, and the score's rule for
#          turning a wind into a sea state follows it
#     AOZ  when the wind is in the top share of the step it is on, the
#          next step is marked as close; the share can be set (weather
#          close <percent>), 25 unless set, measured in knots, upward only
#     APC  the sea state is scored: one state for each wind
#     APF  the fully developed limit is given too, as a ceiling
#
#  THE CURVE is the Beaufort scale's probable wave height, the Met Office's
#  table ("Beaufort wind force scale"; the WMO's figures): for each force
#  its mean wind in knots and the probable height in metres, "for
#  well-developed wind waves of the open sea", joined by straight lines:
#     kt   2    5    9    13   19   24   30   37   44   52   60    64
#     m    0.1  0.2  0.6  1.0  2.0  3.0  4.0  5.5  7.0  9.0  11.5  14
#  (64 kt is where force 12 begins, "14 m and over".)
#
#  THE STATES are the WMO's code 3700 (the Douglas scale as NOAA's NCEI
#  tabulates it): 1 to 0.1 m, 2 to 0.5, 3 slight to 1.25, 4 moderate to
#  2.5, 5 rough to 4, 6 very rough to 6, 7 high to 9, 8 very high to 14,
#  9 phenomenal over 14.
#
#  THE STEPS are where the curve reaches each of those heights, in knots:
#  1, 2, 8, 14.5, 21.5, 30, 39 1/3, 52, 64.  They are written out, not
#  worked from the curve each time, because a step that is found by
#  comparing two floating-point heights can land either side of its own
#  edge; tests/wx-check.awk finds each edge again from the curve and
#  requires it to be the number written here.  A wind that has reached an
#  edge is in the higher state.
#
#  The Met Office's table gives one state for a whole force, and two for
#  forces 4, 7 and 8, which are the forces inside which the curve crosses
#  an edge (14.5, 30 and 39 kt).  This works from the wind itself, so it
#  turns partway through a force where the table cannot.
#
#  FULLY DEVELOPED is Pierson and Moskowitz's limit for a steady wind over
#  open ocean, H = 0.22 U^2 / g with U the wind at 10 m in metres a second
#  (Stewart, Introduction to Physical Oceanography, 16.4), which takes
#  "roughly ten-thousand wave periods" of wind over "five-thousand wave
#  lengths" of sea.  Up to about 24 kt it and the scale agree to a third
#  of a metre; above that it is well over the scale.
#
#  Until 1.0.7 the score used a table of its own (under 7 kt state 1,
#  under 13 state 2, under 19 state 3, under 25 state 4, under 34 state 5,
#  ...), which was one state under the Met Office's heights at 4 to 12 and
#  22 to 24 kt and one over at 56 to 63, and had never been checked
#  against a source.  docs/SOURCES.md, Weather.
# ---------------------------------------------------------------------
function wx_seainit(){
  if(WXS_N) return 0
  WXS_N = split("0 2 5 9 13 19 24 30 37 44 52 60 64", WXS_K, " ")
  split("0 0.1 0.2 0.6 1.0 2.0 3.0 4.0 5.5 7.0 9.0 11.5 14.0", WXS_H, " ")
  split("1 2 8 14.5 21.5 30 0 52 64", WXE, " "); WXE[7] = 118/3
  split("rippled|smooth|slight|moderate|rough|very rough|high|very high|phenomenal", WXS_NAME, "|")
  split("under 0.1 m|0.1 to 0.5 m|0.5 to 1.25 m|1.25 to 2.5 m|2.5 to 4 m|4 to 6 m|6 to 9 m|9 to 14 m|over 14 m", WXS_RNG, "|")
  return 0
}
#  the Beaufort scale's probable wave height at this wind, metres
function wx_seaht(kt,   i){
  wx_seainit()
  if(kt<=0) return 0
  for(i=2;i<=WXS_N;i++) if(kt <= WXS_K[i]+0)
    return WXS_H[i-1] + (WXS_H[i]-WXS_H[i-1])*(kt-WXS_K[i-1])/(WXS_K[i]-WXS_K[i-1])
  return 14.0
}
#  the sea state the scale gives this wind, 0 to 9
function wx_seafor(kt,   i, s){
  wx_seainit(); s=0
  for(i=1;i<=9;i++) if(kt >= WXE[i]+0) s=i
  return s
}
#  the state it is close to, or 0: in the top pct percent of its step
function wx_seaclose(kt, pct,   s){
  s = wx_seafor(kt)
  if(s<1 || s>8 || pct<=0) return 0
  if(kt >= WXE[s+1] - (WXE[s+1]-WXE[s])*pct/100.0) return s+1
  return 0
}
#  fully developed, metres: 0.22 U^2 / g, U in metres a second
function wx_seafull(kt,   v){ v = kt*0.514444; return 0.22*v*v/9.80665 }
function wx_seaname(s){ wx_seainit(); return (s<1 ? "glassy" : WXS_NAME[s]) }
function wx_searange(s){ wx_seainit(); return (s<1 ? "flat" : WXS_RNG[s]) }
function wx_kt(x){ return (x==int(x)) ? sprintf("%d", x) : sprintf("%.1f", x) }
#  the share of a step that counts as close: 25 unless set, 0 to 50
function wx_pct(x){
  if(x=="") return 25
  x = int(x+0); if(x<0) x=0; if(x>50) x=50
  return x
}
#  the sea against the wind, in words: the latest observation's wind, the
#  sea state and the swell logged with it
function wx_seasay(n, pct,   w, h, s, nx, full, ls){
  if(!wx_has(WSPD[n]) || WSPD[n]<0) return 0
  w = WSPD[n]; h = wx_seaht(w); s = wx_seafor(w); pct = wx_pct(pct)
  print ""
  if(s==0) wx_say("The sea: no wind to speak of; the scale expects a glassy sea.")
  else {
    wx_say(sprintf("The sea: at %s kt the Beaufort scale expects about %.1f m, %s.", wx_kt(w), h, wx_seaname(s)))
    wx_why("its probable wave height, for a well-developed sea in open water.")
    wx_why("The sea lags the wind: it builds after the wind does.")
  }
  nx = wx_seaclose(w, pct)
  if(nx>0){
    wx_say(cw(sprintf("Close to %s: the scale turns at %s kt.", wx_seaname(nx), wx_kt(WXE[nx])), C_ACC))
    wx_why(sprintf("your wind is in the top %d%% of the %s step, %s to %s kt.", pct, wx_seaname(s), wx_kt(WXE[s]), wx_kt(WXE[nx])))
  }
  if(wx_has(WSST[n])){
    ls = WSST[n]
    if(ls==s) wx_say(sprintf("You logged a %s sea: what the scale expects.", wx_seaname(ls)))
    else if(ls<s){
      wx_say(sprintf("You logged a %s sea, %s: under the scale.", wx_seaname(ls), wx_searange(ls)))
      wx_why("a sea still building, or short of fetch: the wind has not had the")
      wx_why("time or the distance to raise all it can.")
    } else {
      wx_say(sprintf("You logged a %s sea, %s: above the scale.", wx_seaname(ls), wx_searange(ls)))
      wx_why("more sea than the scale gives this wind. Is some of it swell?")
    }
  }
  if(wx_has(WSWH[n]) && WSWH[n]>0){
    if(wx_has(WSWP[n])) wx_say(sprintf("Your swell: %.1f m at %d seconds.", WSWH[n], int(WSWP[n])))
    else                wx_say(sprintf("Your swell: %.1f m.", WSWH[n]))
    wx_why("swell is sea that has left the wind that raised it, so it is marked")
    wx_why("on its own and not held against this wind.")
  }
  full = wx_seafull(w)
  if(full >= h + 0.1){
    wx_say(sprintf("Fully developed, this wind could raise about %.1f m.", full))
    wx_why("the limit for a steady wind over open ocean (Pierson and")
    wx_why("Moskowitz). It takes roughly ten thousand wave periods of wind")
    wx_why("over five thousand wavelengths of sea; the gap from the scale")
    wx_why("is time and fetch.")
  }
  return 1
}

# ---------------------------------------------------------------------
#  Buys Ballot.
#
#  Wind direction is where it comes FROM, so with your back to it you
#  face wdir+180.  The low is 90 degrees to your left in the northern
#  hemisphere, which is (wdir+180) - 90 = wdir + 90.  To your right in
#  the southern: wdir + 270.
#
#  The first version added and subtracted the 90 the other way round and
#  pointed at the exact opposite side of the sky - 080 for a low that
#  was at 260.  Plausible-looking, completely wrong, and the sort of
#  thing that survives a read-through and not a test.  Sanity check:
#  a westerly in the northern hemisphere (270) gives 000, and a low to
#  the north with a westerly is what a mid-latitude depression does.
function wx_bb(wdir, north,   b){
  b = north ? wdir + 90 : wdir + 270
  while(b>=360) b-=360
  while(b<0)    b+=360
  return int(b+0.5)%360
}
#  THE LOW IS A SECTOR, NOT A LINE (weather 1.0.8; Larry, APK, 17 November
#  2026).  wx_bb is the rule for a wind that runs along the isobars.  The
#  wind on deck does not: the sea turns it 10 to 20 degrees in toward the
#  low (the gradient lesson, W01), so with your back to it the low lies
#  that much FORWARD of the arm Buys Ballot gives.  The report and the
#  page's compass card give the sector from straight off that arm to 20
#  degrees forward of it: clockwise from wx_bb in the north, where the low
#  is on your left; anticlockwise from it in the south, where it is on
#  your right.  wx_bbfar is the forward edge, and wx_bblo and wx_bbhi are
#  the two edges in clockwise order, as bearings are read.
#  Source: Penn State METEO 3 ("with the surface wind at your back ... low
#  pressure is still on your left, but on average, it will lie about 30
#  degrees clockwise from your left arm"; less over water); docs/SOURCES.md.
function wx_bbfar(wdir, north,   b){
  b = wx_bb(wdir, north) + (north ? 20 : 340)
  return b%360
}
function wx_bblo(wdir, north){ return north ? wx_bb(wdir, north) : wx_bbfar(wdir, north) }
function wx_bbhi(wdir, north){ return north ? wx_bbfar(wdir, north) : wx_bb(wdir, north) }

# ---------------------------------------------------------------------
#  THE QUARTER THE LOW IS HEADING INTO (weather 1.0.8; Larry, APR, 17
#  November 2026).  One boat's log cannot give a storm's course.  With two
#  things in it, it can give the quarter of the compass the course lies in:
#
#    the wind has shifted more than 10 degrees: backed, you are on the
#      LEFT of its track, looking the way it is going; veered, the right
#      (APO and APP, above).  On the left, the course lies within the half
#      turn clockwise of the bearing FROM the low TO you; on the right,
#      anticlockwise of it.
#    the glass is falling or rising (wx_band): falling, the low is CLOSING,
#      so its course is within 90 degrees of that same bearing; rising, it
#      is opening, and its course is more than 90 from it.
#
#  Together, with t the bearing from the low to you (the middle of the
#  sector, turned about), the course is in:
#      left and closing     t      to t+90        left and opening   t+90 to t+180
#      right and closing    t-90   to t           right and opening  t-180 to t-90
#  and, holding its course, it comes nearest to you a quarter turn round
#  from it: clockwise of the course on the left, anticlockwise on the right.
#
#  THESE ARE TWO RULES OF THUMB, and the report says so: a low can deepen
#  without moving, or fill where it lies, and the picture is of a straight
#  track and a boat that is slow against the storm.  tests/wx-check.awk
#  moves a low past a boat on every course and requires the course to be
#  inside the quarter this gives.
#
#  Sets WXC_0 and WXC_1 (the quarter, clockwise), WXC_CPA (the bearing it
#  comes nearest on), WXC_LEFT and WXC_CLOSING; returns 0 when the log does
#  not have both things.
# ---------------------------------------------------------------------
function wx_course(lo, hi, dw, band,   t, tr, c0){
  if(dw+0 <= 10 && dw+0 >= -10) return 0
  if(band=="falling" || band=="falling fast") tr=1
  else if(band=="rising") tr=0
  else return 0
  WXC_LEFT = (dw+0 < 0) ? 1 : 0
  WXC_CLOSING = tr
  t = lo + ((hi-lo+360)%360)/2 + 180
  if(WXC_LEFT)  c0 = tr ? t : t+90
  else          c0 = tr ? t-90 : t-180
  WXC_0 = (c0%360+360)%360
  WXC_1 = (WXC_0+90)%360
  WXC_CPA = ((WXC_0 + 45 + (WXC_LEFT ? 90 : 270))%360+360)%360
  return 1
}
function wx_pt8(b,   n, P){
  n = split("north north-east east south-east south south-west west north-west", P, " ")
  return P[int((b%360+360)%360/45 + 0.5)%8 + 1]
}

# ---------------------------------------------------------------------
#  A FRONTAL LOW, LOOKED DOWN ON (W20, weather 1.0.10; Larry, ATR, 18
#  November 2026).  The model behind the lesson `fronts` and its figure:
#  one depression of the northern hemisphere going east, with a warm front
#  running east and south-east from its centre and a cold front running
#  south-west, and the two boats of the figure, one each side of its track.
#
#  THE PRESSURE.  A round low, 990 hPa at the centre and 26 hPa shallower
#  far out, falling off as exp(-(r/700)^2), r in nautical miles from the
#  centre.  EACH FRONT LIES IN A TROUGH (Bowditch 2017, 3810 to 3812): on
#  top of the round low, 2.5 hPa times tanh(d/150), d the distance to the
#  front, so the pressure is lowest along the front and the isobars kink
#  there.  That kink is why the wind shifts at a front.  The fronts only
#  reach south of the centre, so the trough term is weighted by
#  1/(1+exp(y/40)), which is near 1 south of the centre and near 0 north.
#
#  THE WIND.  Along the isobars with the low on its left (Buys Ballot),
#  turned 15 degrees in toward lower pressure: it blows from 75 degrees
#  round from the direction the pressure rises, taken from the local
#  gradient.  So a kink in the isobars is a shift in the wind, and nothing
#  about the shift is written in: it is worked.
#
#  THE GLASS.  The low moves east at 30 knots (an assumption of the
#  figure, said so in it), so a boat that stays put runs west through it,
#  90 nm in three hours.  Its change over those three hours is graded by
#  wx_band(), the barograph's own rule.
#
#  wx.js holds the same model (WX.frP, WX.frFrom, WX.frGlass), and
#  docs/web/tests/weather-fronts.js holds the two to each other character
#  for character over a grid of points (`weather` cmd=frontsdump).
# ---------------------------------------------------------------------
function fr_init(){
  if(FR_READY) return 0
  FRWN = split("0 0 180 -40 330 -150 450 -330 520 -520", FRW, " ") / 2
  FRCN = split("0 0 -60 -160 -110 -330 -140 -520", FRC, " ") / 2
  #  the stations: boat A south of the track, boat B north of it, in the
  #  order the low brings them (x is the low's position east of the boat)
  FRA_N = split("680 440 160 -130 -450", FRAX, " "); FRA_Y = -250
  FRB_N = split("560 0 -560", FRBX, " ");            FRB_Y = 250
  split("ahead of the warm front|the warm front coming|the warm sector|just behind the cold front|well behind the cold front", FRAS, "|")
  split("cirrus, then cirrostratus|altostratus, nimbostratus, rain|stratus, drizzle, haze or fog|cumulonimbus, squalls, showers|clearing, showers, good visibility", FRAK, "|")
  split("cool|cool, warming|warm, moist|turning cold|cold, clear", FRAT, "|")
  split("the low ahead|the low at its nearest|the low past", FRBS, "|")
  FR_READY = 1
  return 0
}
function fr_tanh(x,   e){ e = exp(-2 * (x < 0 ? -x : x)); return (x < 0 ? -1 : 1) * (1 - e) / (1 + e) }
function fr_segd(px, py, ax, ay, bx, by,   dx, dy, t){
  dx = bx - ax; dy = by - ay
  t = ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)
  if(t < 0) t = 0; if(t > 1) t = 1
  dx = px - (ax + t * dx); dy = py - (ay + t * dy)
  return sqrt(dx * dx + dy * dy)
}
function fr_dist(px, py, L, n,   i, d, m){
  m = -1
  for(i = 1; i < n; i++){
    d = fr_segd(px, py, L[2*i-1], L[2*i], L[2*i+1], L[2*i+2])
    if(m < 0 || d < m) m = d
  }
  return m
}
function fr_p(x, y,   p, s){
  fr_init()
  p = 990 + 26 * (1 - exp(-(x * x + y * y) / 490000))
  s = 1 / (1 + exp(y / 40))
  p += s * 2.5 * fr_tanh(fr_dist(x, y, FRW, FRWN) / 150)
  p += s * 2.5 * fr_tanh(fr_dist(x, y, FRC, FRCN) / 150)
  return p
}
#  the bearing the wind blows FROM, degrees true
function fr_from(x, y,   gx, gy, gb){
  gx = (fr_p(x + 1, y) - fr_p(x - 1, y)) / 2
  gy = (fr_p(x, y + 1) - fr_p(x, y - 1)) / 2
  gb = atan2(gx, gy) * 57.29577951308232
  return ((gb + 75) % 360 + 360) % 360
}
#  the glass at a boat over three hours, in hPa: the low moving east at 30 kn
function fr_glass(x, y){ return fr_p(x - 45, y) - fr_p(x + 45, y) }
#  the same, in the barograph's words
function fr_band(x, y){ return wx_band(fr_glass(x, y), 3) }
#  sixteen points
function fr_pt16(b,   P){
  split("N NNE NE ENE E ESE SE SSE S SSW SW WSW W WNW NW NNW", P, " ")
  return P[int((b % 360 + 360) % 360 / 22.5 + 0.5) % 16 + 1]
}
#  the dump the browser's model is held to
function fr_dump(   x, y){
  for(y = 450; y >= -550; y -= 50)
    for(x = -750; x <= 850; x += 50)
      printf "%d %d %.3f %.2f %.3f %s\n", x, y, fr_p(x, y), fr_from(x, y), fr_glass(x, y), fr_band(x, y)
  return 0
}

# ---------------------------------------------------------------------
#  THE ROUTING LESSON'S BOAT AND WATER (weather 1.0.21; gap list W35,
#  book of work B22; Larry's ruling TAYO, 19 November 2026).
#
#  The lesson `routing` teaches how a router works and how far to trust
#  one.  This app does not route (gap list rule 3), so its figures are
#  worked on a made-up boat in a steady wind, small enough to check by
#  hand:
#
#    the boat    her speed at eight angles off the wind, 45 to 150
#                degrees (RT_A, RT_S).  She cannot point above 45 and
#                gybes downwind of 150, as bashnav's router answers only
#                out to a polar's beat and run rows (ROUTER.md, "One
#                step").
#    the water   still, with one wind everywhere.
#
#  In one wind, everywhere she can be after t hours, tacking and gybing
#  as she likes, is t times the outline through her sixteen speeds: the
#  isochrone.  So the time to make good a displacement is the largest of
#  sixteen dot products, one for each side of that outline (rt_g).  The
#  same sum runs backwards from the finish, which is the reverse
#  isochrone, and the two added are the cost of passing through a place.
#
#  Mirrored in docs/web/weather/wx.js (WX.rt*), and held to it character
#  for character by docs/web/tests/weather-route.js (cmd=routedump).
# ---------------------------------------------------------------------
function rt_init(   i, n, a){
  if(RT_N) return 0
  n = split("45 6.0 60 6.9 75 7.5 90 8.0 105 8.1 120 7.9 135 7.5 150 7.0", a, " ")
  RT_M = n / 2
  for(i = 1; i <= RT_M; i++){ RT_A[i] = a[2*i-1] + 0; RT_S[i] = a[2*i] + 0 }
  #  the outline, clockwise from close-hauled on port tack (heading 045
  #  in a northerly) round to close-hauled on starboard (heading 315)
  for(i = 1; i <= RT_M; i++){
    RT_X[i] = RT_S[i] * sin(wx_rad(RT_A[i])); RT_Y[i] = RT_S[i] * cos(wx_rad(RT_A[i]))
  }
  for(i = 1; i <= RT_M; i++){ RT_X[RT_M+i] = -RT_X[RT_M+1-i]; RT_Y[RT_M+i] = RT_Y[RT_M+1-i] }
  RT_N = 2 * RT_M
  #  the worked legs: a reach of 24 miles, a beat of 12, and the finish
  #  of the first figure, 22.5 miles off bearing 075
  RT_REACH = 24; RT_BEAT = 12; RT_LANE = 10
  #  the all-in case: a shift forecast one hour in, of 20 degrees
  RT_TS = 1; RT_SHIFT = 20
  #  how often a forecast is right, by days ahead (NOAA SciJinks)
  split("1 5 90 6 7 80 8 10 50", RT_HZ, " "); RT_HZN = 3
  #  the wind and the stream scaled before routing (Stan Honey's rule of
  #  thumb; docs/SOURCES.md says what was read)
  split("tropics 1.15 mid-latitudes 1.20 high-latitudes 1.25", RT_SC, " "); RT_SCN = 3
  RT_CUR = 1.30
  #  the 2025 Myth of Malham, sailed three times by bashnav's router for
  #  the course's routing page: the wind scaled, hours to the Eddystone,
  #  hours in all (finishing 04:43:58, 03:58:31 and 02:48:09 UTC on 26
  #  May, from a start at 10:00 on the 24th), and when she tacked for
  #  Start Point in Lyme Bay.  From practical-navigator's
  #  site/drafts/routing/runs.js: if the course sails them again, these
  #  move with it.
  split("0.9 25.74 42.7328 02:10 1.0 25.75 41.9753 02:20 1.1 25.53 40.8025 02:20", RT_RUN, " "); RT_RUNN = 3
  return 0
}
#  hours to make good (dx east, dy north) miles in a wind from wd
function rt_g(dx, dy, wd,   r, x, y, m, i, j, nx, ny, h, q){
  rt_init()
  r = wx_rad(wd); x = dx * cos(r) - dy * sin(r); y = dx * sin(r) + dy * cos(r)
  m = 0
  for(i = 1; i <= RT_N; i++){
    j = (i % RT_N) + 1
    nx = RT_Y[j] - RT_Y[i]; ny = -(RT_X[j] - RT_X[i]); h = nx * RT_X[i] + ny * RT_Y[i]
    if(h < 0){ nx = -nx; ny = -ny; h = -h }
    q = (nx * x + ny * y) / h; if(q > m) m = q
  }
  return m
}
#  the time lost by going through (px, py) on the way from the start, at
#  the origin, to (fx, fy), in hours: forward time plus reverse time,
#  less the best
function rt_cost(px, py, fx, fy,   c){
  c = rt_g(px, py, 0) + rt_g(fx - px, fy - py, 0) - rt_g(fx, fy, 0)
  return (c < 0.000000001 ? 0 : c)      # never negative: the last digits of a sum
}
#  how wide the water is, across the middle of the leg, that costs no
#  more than `mins` minutes
function rt_width(fx, fy, mins,   L, ux, uy, s, lo, hi, mid, k, tot){
  L = sqrt(fx*fx + fy*fy); ux = -fy / L; uy = fx / L; tot = 0
  for(s = 1; s >= -1; s -= 2){
    lo = 0; hi = 40
    for(k = 0; k < 40; k++){
      mid = (lo + hi) / 2
      if(rt_cost(fx/2 + s*mid*ux, fy/2 + s*mid*uy, fx, fy) <= mins / 60) lo = mid; else hi = mid
    }
    tot += lo
  }
  return tot
}
#  the all-in case.  She beats for RT_TS hours with a share `a` of it on
#  port tack (1: all of it, the right-hand side; 0: the left), then
#  sails the rest as well as she can in a wind from `wd`
function rt_allin(a, wd,   px, py){
  rt_init()
  px = RT_TS * (a * RT_X[1] + (1 - a) * RT_X[RT_N]); py = RT_TS * RT_Y[1]
  return RT_TS + rt_g(0 - px, RT_BEAT - py, wd)
}
function rt_hm(t,   m){ m = int(t * 60 + 0.5); return sprintf("%d h %02d", int(m / 60), m % 60) }
function rt_dump(   x, y, w, i, a){
  rt_init()
  for(w = -20; w <= 20; w += 10)
    for(y = 24; y >= -24; y -= 4)
      for(x = -24; x <= 24; x += 4)
        printf "g %d %d %d %.4f\n", x, y, w, rt_g(x, y, w)
  for(y = 14; y >= -2; y -= 2)
    for(x = -8; x <= 8; x += 2)
      printf "c %d %d %.4f %.4f\n", x, y, rt_cost(x, y, 0, RT_BEAT), rt_cost(y + 6, x, RT_REACH, 0)
  printf "t %s %s %s\n", rt_hm(rt_g(RT_REACH, 0, 0)), rt_hm(rt_g(0, RT_BEAT, 0)), rt_hm(rt_g(22.5*sin(wx_rad(75)), 22.5*cos(wx_rad(75)), 0))
  printf "w %.1f %.1f\n", rt_width(RT_REACH, 0, RT_LANE), rt_width(0, RT_BEAT, RT_LANE)
  for(a = 0; a <= 1; a += 0.5)
    printf "a %.1f %s %s %s\n", a, rt_hm(rt_allin(a, RT_SHIFT)), rt_hm(rt_allin(a, 0)), rt_hm(rt_allin(a, -RT_SHIFT))
  for(i = 1; i <= RT_HZN; i++) printf "h %d %d %d\n", RT_HZ[3*i-2], RT_HZ[3*i-1], RT_HZ[3*i]
  for(i = 1; i <= RT_SCN; i++) printf "s %s %.2f %.0f\n", RT_SC[2*i-1], RT_SC[2*i], 20 * RT_SC[2*i]
  printf "s stream %.2f %.1f\n", RT_CUR, 2 * RT_CUR
  for(i = 1; i <= RT_RUNN; i++)
    printf "r %.1f %.2f %.2f %.2f %s\n", RT_RUN[4*i-3], RT_RUN[4*i-2], RT_RUN[4*i-1], RT_RUN[4*i-1] - RT_RUN[4*i-2], RT_RUN[4*i]
  return 0
}

# ---------------------------------------------------------------------
#  The report
# ---------------------------------------------------------------------
function wx_say(s){ printf "  %s\n", s; return 0 }
function wx_why(s){ printf "  %s\n", cwd("   " s); return 0 }

function wx_report(logfile, lon, hours, pct,   n, i, j, dt, dp, dw, tide1, tide2, corr, k, b)
{
  if(hours!=24 && hours!=72) hours = 48
  n = wx_load(logfile)
  print ""
  printf "  %s\n", cw("WHAT THE LOG SAYS", C_ACC)
  hr()
  if(n < 2){
    wx_say("Not enough observations yet.")
    wx_why("Almost every rule here needs history, not a snapshot: a tendency")
    wx_why("is a rate, backing is a change, a front is a sequence. Log a few")
    wx_why("three-hourly entries and this page starts working.")
    print ""
    return 0
  }
  j = n
  #  the most recent earlier observation with a pressure, for the trend
  for(i=n-1; i>=1; i--) if(wx_has(WP[i]) && wx_has(WP[n])) break
  k = i

  # ---- pressure -----------------------------------------------------
  if(k>=1 && wx_has(WP[n]) && wx_has(WP[k])){
    dt = (wx_mins(WT[n]) - wx_mins(WT[k]))/60.0
    dp = WP[n] - WP[k]
    tide1 = wx_tide(WT[k], lon, WLAT[k]); tide2 = wx_tide(WT[n], lon, WLAT[n])
    corr = dp - (tide2 - tide1)
    wx_say(sprintf("Pressure %.1f, %+.1f hPa in %.1f hours.", WP[n], dp, dt))
    if(wx_tideok(lon, WLAT[k], WLAT[n])){
      wx_say(sprintf("Allowing for the daily atmospheric tide: %+.1f hPa.", corr))
      wx_why(sprintf("the tide alone accounts for %+.1f of that. It is semidiurnal,", tide2-tide1))
      wx_why("about 1.4 hPa in the tropics and much less in high latitudes,")
      wx_why("and in the tropics it falls 2-3 mb every afternoon in fine weather.")
    } else {
      corr = dp
      if(lon!=""){
        wx_say("The daily atmospheric tide is not allowed for: no latitude in the log.")
        wx_why("its size depends on where you are, 1.4 hPa near the equator and a")
        wx_why("quarter of that at 50 degrees. Log a deck entry with your position.")
      }
    }
    if(dt>0){
      b = wx_band(corr, dt)
      if(b=="falling fast")   wx_say(cw("That is a serious fall. Expect a deepening system and a rising wind.", C_WARN))
      else if(b=="falling")   wx_say("A definite fall. Something is coming.")
      else if(b=="rising")    wx_say("Rising. The gradient is easing or a ridge is building.")
      else                    wx_say("Near steady.")
      wx_why("a rate matters more than a level: 1000 hPa steady is a quiet day,")
      wx_why("1015 falling fast is not.")
    }
    wx_glass(lon, hours)
  } else {
    wx_say("No pressure trend - fewer than two entries carry a pressure.")
  }

  # ---- wind: backing or veering, and Buys Ballot --------------------
  if(k>=1 && wx_has(WDIR[n]) && wx_has(WDIR[k])){
    dw = wx_d180(WDIR[n] - WDIR[k])
    print ""
    if(dw > 10)       wx_say(sprintf("Wind has VEERED %d degrees, %03d to %03d.", int(dw+0.5), WDIR[k], WDIR[n]))
    else if(dw < -10) wx_say(sprintf("Wind has BACKED %d degrees, %03d to %03d.", int(-dw+0.5), WDIR[k], WDIR[n]))
    else              wx_say(sprintf("Wind steady in direction, about %03d.", WDIR[n]))
    #  WHAT A SHIFT TELLS YOU, WHICHEVER WAY THE STORM IS GOING (weather
    #  1.0.8; Larry, APO and APP, 17 November 2026).  Until then this said,
    #  in the north, "backing with a falling glass puts the centre to your
    #  north and closing", and in the south only "the sense of all of this
    #  reverses".  The first is true of a storm going WEST and false of
    #  one going east, which is what the veer lesson describes; Larry asked
    #  for the picture from above, and it showed the two were one rule with
    #  the storm going opposite ways.  Worked for all eight cases (each
    #  hemisphere, the storm going east or west, the boat north or south
    #  of its track): the low's bearing from a boat that stays put swings
    #  the same way whichever way the wind goes round the low, so on the
    #  left of the track the wind backs and on the right it veers, in both
    #  hemispheres.  tests/wx-check.awk works the eight again.
    if(dw > 10){
      wx_why("if the wind goes on veering, you are on the right of the storm's")
      wx_why("track, looking the way it is going: it passes north of you if it")
      wx_why("is going east, south of you if it is going west.")
    }
    if(dw < -10){
      wx_why("if the wind goes on backing, you are on the left of the storm's")
      wx_why("track, looking the way it is going: it passes south of you if it")
      wx_why("is going east, north of you if it is going west.")
    }
  }
  #  Buys Ballot
  if(wx_has(WDIR[n])){
    print ""
    wx_say(sprintf("Back to the wind: the low is between %03d and %03d from you.",
           wx_bblo(WDIR[n], wx_north(WLAT[n])), wx_bbhi(WDIR[n], wx_north(WLAT[n]))))
    wx_why("Buys Ballot. Stand with your back to the wind: in the northern")
    wx_why("hemisphere the low is on your left, in the southern, on your right,")
    wx_why("and up to 20 degrees forward of that arm, because the sea turns the")
    wx_why("wind on deck in toward the low.")
    #  the quarter it is heading into, when the log has a shift and a
    #  moving glass (APR)
    if(wx_course(wx_bblo(WDIR[n], wx_north(WLAT[n])), wx_bbhi(WDIR[n], wx_north(WLAT[n])), dw, b)){
      wx_say(sprintf("Its course is somewhere between %03d and %03d.", WXC_0, WXC_1))
      if(WXC_CLOSING) wx_say(sprintf("If it holds that, it passes to your %s.", wx_pt8(WXC_CPA)))
      else            wx_say("It is drawing away.")
      wx_why(sprintf("the wind has %s, so you are on the %s of its track; the glass", (WXC_LEFT ? "backed" : "veered"), (WXC_LEFT ? "left" : "right")))
      wx_why(sprintf("is %s, so it is %s. A low can deepen without", (WXC_CLOSING ? "falling" : "rising"), (WXC_CLOSING ? "closing" : "opening")))
      wx_why("moving, or fill where it lies: this is where to watch, not a fix.")
    }
  }

  # ---- fog -----------------------------------------------------------
  if(wx_has(WDEW[n]) && wx_has(WSEA[n])){
    print ""
    if(WDEW[n] >= WSEA[n] - 0.5){
      wx_say(cw("Fog is likely: the dew point is at or above the sea temperature.", C_WARN))
      wx_why("air moving over water colder than its own dew point condenses.")
    } else {
      wx_say(sprintf("Fog unlikely: dew point %.1f, sea %.1f, a margin of %.1f.",
             WDEW[n], WSEA[n], WSEA[n]-WDEW[n]))
    }
  }

  # ---- cloud base ----------------------------------------------------
  if(wx_has(WAIR[n]) && wx_has(WDEW[n])){
    print ""
    wx_say(sprintf("Cloud base about %d ft (%d m).",
           int((WAIR[n]-WDEW[n])*400), int((WAIR[n]-WDEW[n])*125)))
    wx_why("the spread closes at about 2.5 C per 1000 ft - a parcel cools at 3,")
    wx_why("its dew point falls at 0.5, and the difference is what counts. Not")
    wx_why("the lapse rate alone: that would put the base a sixth too low.")
  }

  # ---- the cloud sequence -------------------------------------------
  wx_cloud(logfile)

  # ---- visibility, which we also used to ask for and ignore ---------
  if(WVIS[n]>=0 && k>=1 && WVIS[k]>=0 && WVIS[n]!=WVIS[k]){
    print ""
    if(WVIS[n] < WVIS[k]){
      wx_say(sprintf("Visibility is closing in: code %d down to %d.", WVIS[k], WVIS[n]))
      wx_why("with a falling glass that is usually rain arriving ahead of a front;")
      wx_why("with the dew point near the sea temperature it is fog.")
    } else {
      wx_say(sprintf("Visibility improving: code %d up to %d.", WVIS[k], WVIS[n]))
    }
  }

  # ---- the sea against the wind (W09) --------------------------------
  wx_seasay(n, pct)

  # ---- swell, the earliest warning there is --------------------------
  if(wx_has(WSWP[n]) && WSWP[n] >= 12){
    print ""
    wx_say(cw(sprintf("A %d-second swell from %03d.", int(WSWP[n]), WSWD[n]), C_ACC))
    wx_why("long-period swell outruns the storm that made it. This can be the")
    wx_why("first news of a system, with a steady glass and a clear sky.")
  }
  hr()
  wx_say(cwd("This reasons only from what you logged. It is not a forecast:"))
  wx_say(cwd("no model, no chart, no GRIB. It is you, reading your own barometer."))
  print ""
  return 0
}

# ---------------------------------------------------------------------
#  The cloud sequence - the rule those three cloud codes are FOR.
#
#  A warm front announces itself hours ahead, in order: cirrus, then
#  cirrostratus thickening and lowering, then altostratus, then rain.
#  Reading it needs cloud TYPE over time, which is why the observation
#  asks for CL, CM and CH separately and why total cover cannot do it.
#
#  In the first build we asked for all three and never used them, which
#  is how you teach somebody to stop filling in a form.
# ---------------------------------------------------------------------
function wx_cloud(logfile,   n, i, j, hi, mid, lo, seq, prev){
  n = WN
  if(n<2) return 0
  print ""
  #  did high cloud appear and then middle cloud follow it?
  hi=0; mid=0; lo=0
  for(i=1;i<=n;i++){
    if(WCH[i]>0) hi=i
    if(WCM[i]>0 && i>=hi && hi>0) mid=i
    if(WCL[i]>=6 && mid>0 && i>=mid) lo=i
  }
  if(lo>0){
    printf "  %s\n", cw("The cloud has run the whole warm-front sequence: high, then", C_WARN)
    printf "  %s\n", cw("middle, and now low stratus. The front is on you or past.", C_WARN)
  } else if(mid>0 && mid>hi-1){
    printf "  %s\n", cw("Cirrus has thickened to middle cloud - the classic warm front", C_ACC)
    printf "  %s\n", cw("sequence, and it is well under way.", C_ACC)
    printf "  %s\n", cwd("   expect the glass to keep falling, the wind to back, and rain")
  } else if(hi>0 && WCH[n]>0){
    printf "  %s\n", "High cloud is in. On its own it means very little -"
    printf "  %s\n", "but if it thickens and lowers over the next watches, that is a"
    printf "  %s\n", "warm front announcing itself hours ahead."
  } else return 0
  printf "  %s\n", cwd("   cirrus -> cirrostratus -> altostratus -> nimbostratus and rain")
  return 1
}
# =====================================================================
#  deck-log -- forecast, verify, score.
#
#  THE ORDER IS THE POINT.  The user's forecast is committed to the log
#  BEFORE the app shows any of its own reasoning.  Print the guess first
#  and the person has not forecast anything - they have read an answer
#  and agreed with it.  It feels like learning and is not.  Same bug as
#  the colregs lights quiz telling you the aspect and then asking for
#  it; house rule now: never tell before you ask.
#
#  AND THREE ARE SCORED, not one.  Scoring only the user would make this
#  an oracle and it is not one: every rule in it is a rule of thumb.
#  Scoring the rules too keeps it honest, teaches calibration, and lets
#  the user eventually win - which is the point, because a training tool
#  that cannot be outgrown is badly built.
#
#  The third is PERSISTENCE: "in twelve hours it will be much as it is
#  now."  It is the honest floor.  Hard to beat at short range, and a
#  forecast that does not beat it has shown no skill at all.  Standard
#  practice in operational meteorology, and free.
# =====================================================================

#  Error points, taken from the WxChallenge: weighted, continuous, low
#  score wins.  A near miss should score like a near miss, which one
#  right/wrong verdict per forecast cannot express.
function sc_pts(field, a, b,   d){
  if(a<=-9000 || b<=-9000) return -1          # not comparable
  if(field=="wdir"){ d = wx_d180(a-b); if(d<0) d=-d; return d * 0.1 }
  d = a-b; if(d<0) d=-d
  if(field=="wspd") return d * 0.5
  if(field=="mslp") return d * 1.0
  if(field=="sea")  return d * 2.0
  return d
}
function sc_label(f){
  if(f=="wdir") return "wind direction"
  if(f=="wspd") return "wind speed"
  if(f=="mslp") return "pressure"
  if(f=="sea")  return "sea state"
  return f
}
#  distinct short names: truncating the long ones gives "wind" twice,
#  which is a column of numbers nobody can read
function sc_short(f){
  if(f=="wdir") return "dir"
  if(f=="wspd") return "spd"
  if(f=="mslp") return "hPa"
  if(f=="sea")  return "sea"
  return f
}

#  The sea state for a given wind: the one the Beaufort scale's probable
#  wave height gives it (wx_seafor in wx.awk, where the curve, the states
#  and their sources are; Larry, AOU, 17 November 2026).  Used to turn a
#  forecast wind into a forecast sea state; it is a rule of thumb and is
#  scored like everything else.
#
#  Until weather 1.0.7 this was a table of its own, never checked against
#  a source, and one state away from the Met Office's heights in four
#  bands of wind.  It was also never scored: see sc_verify.
function sc_sea(kt){ return wx_seafor(kt) }

# ---------------------------------------------------------------------
#  The two machine forecasters.
#
#  Both are deliberately simple and both are honest about it.  The whole
#  reason they are scored is that nobody, including whoever wrote them,
#  knows how good they are until a season of observations says so.
# ---------------------------------------------------------------------
function sc_persist(n){
  F_WDIR = WDIR[n]; F_WSPD = WSPD[n]; F_MSLP = WP[n]
  F_SEA  = (wx_has(WSPD[n]) ? sc_sea(WSPD[n]) : -9999)
  F_WHY  = "nothing changes"
  return 0
}
function sc_rules(n, k, hours, lon,   dt, dp, dw, rate, damp, p, w, d, tide1, tide2){
  F_WDIR=-9999; F_WSPD=-9999; F_MSLP=-9999; F_SEA=-9999; F_WHY=""
  if(k<1){ sc_persist(n); F_WHY="only one observation - nothing but persistence to offer"; return 0 }
  dt = (wx_mins(WT[n]) - wx_mins(WT[k]))/60.0
  if(dt<=0){ sc_persist(n); return 0 }
  #  a trend does not continue for ever: damp it
  damp = 0.7

  if(wx_has(WP[n]) && wx_has(WP[k])){
    dp = WP[n] - WP[k]
    if(wx_tideok(lon, WLAT[k], WLAT[n])){
      tide1 = wx_tide(WT[k], lon, WLAT[k]); tide2 = wx_tide(WT[n], lon, WLAT[n])
      dp = dp - (tide2 - tide1)
    }
    rate = dp/dt
    F_MSLP = WP[n] + rate*hours*damp
    F_WHY = sprintf("pressure trend %+.2f hPa/h, damped, carried %g h", rate, hours)
    #  a falling glass is a rising wind: the classic rule, crudely
    if(wx_has(WSPD[n])){
      w = WSPD[n] - rate*hours*2.0
      if(w<0) w=0
      F_WSPD = w
    }
  } else if(wx_has(WSPD[n])) F_WSPD = WSPD[n]

  if(wx_has(WDIR[n]) && wx_has(WDIR[k])){
    dw = wx_d180(WDIR[n]-WDIR[k])/dt
    d = WDIR[n] + dw*hours*damp
    while(d<0) d+=360
    while(d>=360) d-=360
    F_WDIR = d
    if(F_WHY!="") F_WHY = F_WHY sprintf("; turning %+.1f deg/h, damped", dw)
  } else F_WDIR = WDIR[n]

  if(wx_has(F_WSPD)) F_SEA = sc_sea(F_WSPD)
  return 0
}

#  Find the observation nearest a valid time, within a tolerance.
function sc_nearest(target, tolmin,   i, d, best, bd){
  best=0; bd=999999
  for(i=1;i<=WN;i++){
    d = wx_mins(WT[i]) - wx_mins(target); if(d<0) d=-d
    if(d<bd){ bd=d; best=i }
  }
  if(best==0 || bd>tolmin) return 0
  return best
}

# ---------------------------------------------------------------------
#  Verify and score.  Reads the fc records out of the log, finds the
#  observation each was made for, and scores every forecaster on every
#  field it offered.
# ---------------------------------------------------------------------
function sc_verify(logfile,   i, j, by, fo, o, f, p, nf, any, tot, cnt, fields, nfld){
  wx_load(logfile)
  nfld = split("wdir wspd mslp sea", fields, " ")
  for(i in TOT) delete TOT[i]
  for(i in CNT) delete CNT[i]
  for(i in FTOT) delete FTOT[i]
  for(i in FCNT) delete FCNT[i]
  VN=0
  lg_read(logfile, "fc")
  for(i=1;i<=LG_N;i++){
    if(!lg_at(i)) continue
    fo = LG["for"]; by = LG["by"]
    if(fo=="" || by=="") continue
    #  THE USER'S OWN FORECASTS WERE NEVER SCORED.  do_forecast writes
    #  by=user; this report's three names are "you rules persist", so
    #  TOT["user"] was accumulated and then never looked at -- the one
    #  column the whole learning loop exists for was silently missing,
    #  and "You are beating the rule set" could never fire.
    #
    #  Fixed by NORMALISING ON READ rather than by renaming the writer
    #  alone: the log is append-only, so every fc record already written
    #  says user and has to keep working for ever.  New records say you.
    if(by=="user") by="you"
    o = sc_nearest(fo, 180)
    if(o==0) continue                       # nothing observed yet
    VN++
    VBY[VN]=by; VFOR[VN]=fo; VMADE[VN]=LG_TS; VWHY[VN]=LG["why"]
    for(j=1;j<=nfld;j++){
      f = fields[j]
      if(LG[f]=="" || LG[f]=="-") continue
      if(f=="wdir") p = sc_pts(f, LG[f]+0, WDIR[o])
      else if(f=="wspd") p = sc_pts(f, LG[f]+0, WSPD[o])
      else if(f=="mslp") p = sc_pts(f, LG[f]+0, WP[o])
      #  THE SEA STATE WAS FORECAST BY ALL THREE AND SCORED FOR NONE.  The
      #  weight was written (two points a state), the question was asked
      #  and the answer was stored, but the sea state the log holds was
      #  never read, so there was nothing to hold a forecast against and
      #  this branch gave "not comparable" every time.  Scored since
      #  weather 1.0.7 (Larry, APC): one state for each wind, against the
      #  state logged nearest the valid time; an observation with no sea
      #  state logged is still not comparable.
      else if(f=="sea")  p = sc_pts(f, LG[f]+0, WSST[o])
      else p = -1
      if(p<0) continue
      TOT[by] += p; CNT[by]++
      FTOT[by SUBSEP f] += p; FCNT[by SUBSEP f]++
      any=1
    }
  }
  return VN
}

function sc_report(logfile,   n, by, i, f, fields, nfld, j, names, nn){
  n = sc_verify(logfile)
  print ""
  printf "  %s\n", cw("THE SCORE", C_ACC)
  hr()
  if(n==0){
    printf "  %s\n", cwd("No forecast has reached its valid time yet, or no observation")
    printf "  %s\n", cwd("has been logged near one. Make a forecast, then log the")
    printf "  %s\n", cwd("observation it was for, and this page fills in.")
    print ""
    return 0
  }
  nn = split("you rules persist", names, " ")
  nfld = split("wdir wspd mslp sea", fields, " ")
  printf "  %-10s %8s  %s\n", "", "points", "per field, points per forecast"
  for(i=1;i<=nn;i++){
    by = names[i]
    if(!(by in CNT)) continue
    printf "  %-10s %8.1f ", by, TOT[by]
    for(j=1;j<=nfld;j++){
      f = fields[j]
      if((by SUBSEP f) in FCNT)
        printf "  %s %.1f", sc_short(f), FTOT[by SUBSEP f]/FCNT[by SUBSEP f]
    }
    print ""
  }
  hr()
  printf "  %s\n", cwd("Lower is better. Half a point per knot, one per millibar, a tenth")
  printf "  %s\n", cwd("per degree of wind direction, two per sea state - so a near miss")
  printf "  %s\n", cwd("scores like one.")
  print ""
  if(("persist" in CNT) && ("rules" in CNT)){
    if(TOT["rules"]/CNT["rules"] > TOT["persist"]/CNT["persist"])
      printf "  %s\n", cw("The rules are not beating persistence. That is the honest result", C_WARN)
    if(TOT["rules"]/CNT["rules"] > TOT["persist"]/CNT["persist"])
      printf "  %s\n", cw("so far, and it is worth knowing.", C_WARN)
  }
  if(("you" in CNT) && ("rules" in CNT)){
    if(TOT["you"]/CNT["you"] < TOT["rules"]/CNT["rules"])
      printf "  %s\n", cw("You are beating the rule set. Trust yourself over it here.", C_ACC)
  }
  print ""
  return n
}

#  Round a time forward to the next multiple of 3 hours, <hours> ahead.
#  Forecasts are made FOR a synoptic hour, so the observation that
#  verifies one is an entry somebody would have made anyway.
#
#  The first version of the inverse conversion below returned the year
#  4600 for a date in 2026.  Date arithmetic written from memory is a
#  reliable way to be confidently wrong, which is why there is now a
#  test that round-trips every day for forty years.
function sc_jdn(y, mo, d,   a, y2, m2){
  a = int((14-mo)/12); y2 = y + 4800 - a; m2 = mo + 12*a - 3
  return d + int((153*m2+2)/5) + 365*y2 + int(y2/4) - int(y2/100) + int(y2/400) - 32045
}
#  Fliegel and Van Flandern, the standard inverse.  Sets SC_Y/SC_M/SC_D.
function sc_civil(jd,   a, b, c, dd, e, m){
  a = jd + 32044
  b = int((4*a+3)/146097)
  c = a - int(146097*b/4)
  dd = int((4*c+3)/1461)
  e = c - int(1461*dd/4)
  m = int((5*e+2)/153)
  SC_D = e - int((153*m+2)/5) + 1
  SC_M = m + 3 - 12*int(m/10)
  SC_Y = 100*b + dd - 4800 + int(m/10)
  return 0
}
function sc_validtime(ts, hours,   y,mo,d,h,tot,jd,rh){
  y=substr(ts,1,4)+0; mo=substr(ts,6,2)+0; d=substr(ts,9,2)+0
  h=substr(ts,12,2)+0
  jd = sc_jdn(y, mo, d)
  tot = jd*24 + h + hours
  rh = tot % 3
  if(rh!=0) tot += (3-rh)
  jd = int(tot/24); h = tot - jd*24
  sc_civil(jd)
  return sprintf("%04d-%02d-%02dT%02d:00Z", SC_Y, SC_M, SC_D, h)
}
# =====================================================================
#  weather -- reasoning over a 500 mb chart the user is holding.
#
#  The app cannot fetch a chart and never will.  But a 500 mb chart
#  arrives by HF RADIOFAX, on an SSB receiver, at sea, with no
#  connectivity at all - which is exactly the situation the rest of
#  bashnav is built for.  So this is the reasoning layer over a fax:
#  read three numbers off it and the rules do the rest, showing every
#  step.
#
#  Rules from Sienkiewicz & Chesneau, Mariner's Guide to the
#  500-Millibar Chart, NOAA - public domain.  See docs/SOURCES.md.
# =====================================================================
function ch_say(s){ printf "  %s\n", s; return 0 }
function ch_why(s){ printf "  %s\n", cwd("   " s); return 0 }

#  brg    bearing FROM you TO the nearest point of the 564 line
#  dist   its distance in nm
#  orient the line's own orientation, as a bearing (either end)
#  w500   the 500 mb wind speed there, knots
#  north  1 northern hemisphere, 0 southern
function ch_report(brg, dist, orient, w500, north,   pole, side, mn, mx, smn, smx){
  print ""
  printf "  %s\n", cw("FROM THE 500 MILLIBAR CHART", C_ACC)
  hr()
  pole = north ? "north" : "south"

  if(dist=="" || brg==""){
    ch_say("Give me where the 564 line runs and I will walk the rules.")
    print ""
    return 0
  }
  ch_say(sprintf("The 5640 m contour is %g nm away, bearing %03d, lying %03d/%03d.",
         dist+0, brg+0, orient+0, (orient+180)%360))
  print ""

  # ---- 1. the storm track -------------------------------------------
  ch_say(cw("The surface storm track", C_ACC) sprintf(" runs parallel to that line, %s of it,", pole))
  ch_say("between 300 and 600 nm away from it.")
  ch_why("so the depressions are travelling along " sprintf("%03d/%03d", orient+0, (orient+180)%360) ", not toward you")

  # ---- 2. the gale boundary, which is the one that matters ----------
  print ""
  ch_say(cw("All the gale force winds are on the " pole " side of the 564 line.", C_WARN))
  if(ch_poleward(brg, north)){
    ch_say(cw("You are on the equatorward side of it. That is the right side.", C_OK))
    ch_why("stay there and you stay out of the gales - that is the routing rule,")
    ch_why("and it is why the standard book on this is called Heavy Weather Avoidance")
  } else {
    ch_say(cw("The line is equatorward of you, so you are on the gale side of it.", C_WARN))
    ch_why("getting equatorward of the 564 line is the single most useful thing")
    ch_why("you can do about the weather from here")
  }

  # ---- 3 and 4. speed and strength, if the wind was read ------------
  if(w500!=""){
    print ""
    mn = (w500+0)/3.0; mx = (w500+0)/2.0
    ch_say(sprintf("At %g knots aloft, systems below move at %.0f to %.0f knots.",
           w500+0, mn, mx))
    ch_why("a surface low or front travels at a third to a half of the 500 mb wind")
    if(dist+0 > 0){
      ch_say(sprintf("So a system 300 nm off would be on you in %.0f to %.0f hours.",
             300.0/mx, 300.0/mn))
    }
    print ""
    ch_say(sprintf("Behind it, in the cold air, expect about %.0f knots on deck.", (w500+0)/2.0))
    ch_why("surface wind in the west-to-southwest quadrant is about half the 500 mb")
    ch_why("wind - which is the number that decides what sail you are carrying")
  }
  hr()
  printf "  %s\n", cwd("Rules from Sienkiewicz and Chesneau, Mariner's Guide to the")
  printf "  %s\n", cwd("500-Millibar Chart, NOAA. They are rules of thumb: good ones,")
  printf "  %s\n", cwd("and still rules of thumb.")
  print ""
  return 0
}
#  Is the 564 line on my POLEWARD side?  If it bears north of me in the
#  northern hemisphere, I am equatorward of it, which is where I want
#  to be.
function ch_poleward(brg, north,   b){
  b = brg+0
  while(b<0) b+=360
  while(b>=360) b-=360
  if(north) return (b < 90 || b > 270)     # the line lies to my north
  return (b > 90 && b < 270)               # southern: to my south
}

# =====================================================================
#  THE WIND FROM THE ISOBARS (W07; weather 1.0.3; Larry, AKY and ALF,
#  16 November 2026).  The second chart a navigator reads, the surface
#  chart: measure the spacing between two isobars, and the balance of
#  the push toward the low against the earth's turn gives the wind aloft
#  (the geostrophic wind).  W01's rules then take it down to the deck.
#  It teaches the course's "Reading the forecast" level (3A).
#
#      wind aloft = (isobar interval) / (air density x f x spacing)
#      f = 2 x 7.292115e-5 x sin(latitude), the earth's turn where you are
#
#  Air density 1.225 kg/m3, as the wind panel uses (grid.awk wx_pgf).
#  Sources: the American Meteorological Society's glossary,
#  "geostrophic wind scale"; US Navy aerographer's mate training (tpub
#  weather2 7-10); docs/SOURCES.md.  The deck rules are W01's: about 2/3
#  backed 10-20 degrees over the sea, 1/3 to 2/3 backed 30-40 over land.
#  Within 5 degrees of the equator the balance does not hold (the earth's
#  turn is too weak there), so the tool refuses rather than give a number.
# =====================================================================
function iso_wind(sp, lat, step,   f){
  f = 2 * 7.292115e-5 * sin(wx_rad(lat < 0 ? -lat : lat))
  return (step * 100.0) / (1.225 * f * sp * 1852.0) * 1.943844
}
function iso_table(step, north,   r,c,line,SP,LT,ns,nl,h){
  ns = split("50 75 100 150 200 300", SP, " ")
  nl = split("30 40 50 60", LT, " ")
  h = north ? "N" : "S"
  ch_say(cw("The scale", C_ACC) sprintf(": the wind aloft in knots, isobars %g hPa apart", step))
  line = "   spacing, nm"
  for(c=1;c<=nl;c++) line = line sprintf("%8s", LT[c] " " h)
  ch_say(line)
  for(r=1;r<=ns;r++){
    line = sprintf("%14s", SP[r])
    for(c=1;c<=nl;c++) line = line sprintf("%8.0f", iso_wind(SP[r], LT[c], step))
    ch_say(line)
  }
  return 0
}
#  spacing  nm between two neighbouring isobars (minutes of latitude)
#  lat      latitude, degrees, 0 to 90
#  step     the isobar interval, hPa (4 on most charts)
#  north    1 northern hemisphere, 0 southern
function iso_report(spacing, lat, step, north,   v, h, turn){
  print ""
  printf "  %s\n", cw("THE WIND FROM THE ISOBARS", C_ACC)
  hr()
  if(step == "") step = 4
  h = north ? "N" : "S"
  turn = north ? "backed" : "veered"
  if(spacing == "" || lat == ""){
    ch_say("Give me the spacing between two isobars and your latitude, and I")
    ch_say("will work the wind.")
    print ""
    return 0
  }
  if(spacing+0 <= 0){ ch_say("The spacing must be more than nothing: measure it in nautical miles."); print ""; return 0 }
  if(step+0 <= 0){ ch_say("The isobar interval must be more than nothing: 4 hPa on most charts."); print ""; return 0 }
  if(lat+0 < 0 || lat+0 > 90){ ch_say("A latitude runs from 0 to 90 degrees; say north or south apart."); print ""; return 0 }
  ch_say(sprintf("Isobars %g hPa apart and %g nm between them, at %g degrees %s.", step+0, spacing+0, lat+0, h))
  print ""
  if(lat+0 < 5){
    ch_say(cw("Within 5 degrees of the equator the isobars do not give the wind.", C_WARN))
    ch_why("the earth's turn is too weak there to balance the push toward the")
    ch_why("low, so there is no steady wind along the isobars to work out;")
    ch_why("believe the wind you can see")
    print ""
    return 0
  }
  v = iso_wind(spacing+0, lat+0, step+0)
  ch_say(cw(sprintf("The wind aloft runs along the isobars at %.0f knots.", v), C_ACC))
  ch_why("the closer the isobars, the harder the push toward the low; the")
  ch_why("earth's turn bends the wind until the bend matches the push")
  ch_say(sprintf("On deck, over the sea: about %.0f knots, %s 10 to 20 degrees.", v*2/3, turn))
  ch_why("the drag of the sea slows it and turns it in toward the low")
  ch_say(sprintf("Over land: %.0f to %.0f knots, %s 30 to 40 degrees.", v/3, v*2/3, turn))
  ch_why("towns and forests at the slow end, open fields at the fast end")
  print ""
  ch_say("This is the wind for straight isobars. Round a tight low expect")
  ch_say("less, round a high more.")
  ch_why("the curve of the isobars changes the speed; the coriolis lesson's")
  ch_why("wind panel shows by how much")
  print ""
  iso_table(step+0, north)
  print ""
  hr()
  ch_say("The geostrophic wind: the push toward the low balanced by the")
  ch_say("earth's turn, air density 1.225 kg/m3. The spacing in nautical")
  ch_say("miles is minutes of latitude: measure it on the chart's side scale.")
  print ""
  return 0
}

#  THE SCALE, IN A LESSON (W07, weather 1.0.3): the wind aloft against the
#  spacing of the isobars, for the gradient lesson.  The terminal prints it
#  as a table; the browser draws it as curves (kind "isoscale"), with the
#  lesson's example marked, 100 nm at 50 N.  It lives here, beside
#  iso_wind, and not in grid.awk with the other figures: the rule checks
#  load grid.awk without chart.awk, and mawk refuses a file that calls a
#  function it cannot see (found by the suite the first time it ran).
function iso_scale_figure(   w,h,r,c,SP,LT,ns,nl,line){
  w=64; h=9
  gclear(w,h)
  FIGNAME = "isoscale"
  ns = split("50 75 100 150 200 300", SP, " ")
  nl = split("30 40 50 60", LT, " ")
  gputsc(0, 2, "THE WIND ALOFT, KNOTS, ISOBARS 4 hPa APART", C_ACC)
  line = " spacing, nm"
  for(c=1;c<=nl;c++) line = line sprintf("%8s", LT[c] " N")
  gputsc(2, 2, line, C_DIM)
  for(r=1;r<=ns;r++){
    line = sprintf("%12s", SP[r])
    for(c=1;c<=nl;c++) line = line sprintf("%8.0f", iso_wind(SP[r], LT[c], 4))
    if(SP[r] == 100) gputsc(2 + r, 2, line, C_ACC); else gputs(2 + r, 2, line)
  }
  return 0
}

# ---------------------------------------------------------------------
#  A REPORTED STORM, AS A CHECK ON YOUR OWN WIND (I20, weather 1.0.11;
#  Larry, ATZ, 18 November 2026).  You type in an official advisory: how
#  long ago it was issued, the centre's position, its movement, and how far
#  out its 34-knot winds reach; and where you are, your course and speed,
#  and the wind you have.  It answers five things:
#
#    1. where the centre is NOW: the advisory's position moved on along its
#       track for the hours since it was issued;
#    2. which side of the track you are on, looking the way the storm goes,
#       and so which side is dangerous: north of the equator its right,
#       south of it its left (Bowditch 2017, 3913, pp. 657-658), and which
#       way your wind will shift as it passes: veer on its right, back on
#       its left;
#    3. how close it comes, and when, if both hold their course and speed,
#       and whether that is inside its 34-knot winds;
#    4. whether your own wind agrees.  Facing the wind, the centre is about
#       110 degrees to your right ahead of the storm and 120 to 135 behind
#       it, to your left south of the equator; nearer the centre, a point or
#       two less (Bowditch, p. 655).  So ahead of it the band runs from 110
#       less two points (22.5 degrees) to 110; behind it, from 120 less two
#       points to 135; with no track to be ahead of or behind, from 87.5 to
#       135.  Within the band it agrees; within 15 degrees of it, near
#       enough for a wind read by eye; further off, the two disagree and one
#       of them is wrong or old;
#    5. that it is not a forecast: an advisory is hours old when it arrives,
#       and a storm can turn (Bowditch, p. 658).
#
#  THE CHART IS FLAT, ROUND YOU: east and north in nautical miles, a degree
#  of latitude 60 nm and of longitude 60 cos(mean latitude).  Within a few
#  hundred miles that is good to a few miles, and the report says so.
#
#  NEAR ITS PATH means ahead of the centre and closer to its track than its
#  34-knot winds reach (30 nm when the advisory gives no radius): a line of
#  the app's own, said as a fact and not as an order, since what to do
#  there is seamanship (PILOT's) and not this tool's.
#
#  THE WORDS ARE THE CREW'S SHARED WORDS (Larry, TAWG, 18 November 2026;
#  the navigationtools design system, "Shared words"): lines 1, 2, 4 and 5
#  are printed as they stand there, and the angle is the one used on the
#  watch faces and in the course, 110 ahead and 120 to 135 behind.
#  weather 1.0.15.  Before it this screen used one band, 110 to 135,
#  whether ahead or behind, and refused the south.
#
#  BOTH HEMISPHERES (TAWG settled card I19, part three): the same rule,
#  its left the dangerous side in the south, the centre to your left.
#  Which hemisphere is the storm's; a storm and a boat on opposite sides
#  of the equator are refused, since its side and its wind turn the other
#  way across it.
#
#  chart.js holds the same reasoning (CHART.stormReport) and
#  docs/web/tests/weather-storm.js holds the two to each other character
#  for character, and the closest approach to a brute-force search.
# ---------------------------------------------------------------------
function st_r(x){ return int(x + 0.5) }
function st_b(x){ x = (x % 360 + 360) % 360; return int(x + 0.5) % 360 }
#  a latitude or longitude typed as signed degrees, or with N S E W after
function st_deg(s, lim,   t, sg, v){
  t = s; gsub(/[ \t]/, "", t); sg = 1
  if(t ~ /[NnEe]$/){ t = substr(t, 1, length(t) - 1) }
  else if(t ~ /[SsWw]$/){ t = substr(t, 1, length(t) - 1); sg = -1 }
  if(t !~ /^[-+]?([0-9]+\.?[0-9]*|\.[0-9]+)$/) return "x"
  v = sg * (t + 0)
  if(v < -lim || v > lim) return "x"
  return v
}
function st_num(s,   t){
  t = s; gsub(/[ \t]/, "", t)
  if(t == "") return ""
  if(t !~ /^[-+]?([0-9]+\.?[0-9]*|\.[0-9]+)$/) return "x"
  return t + 0
}
function st_report(age, clat, clon, mdir, mkn, r34, blat, blon, bcse, bkn, wind,
                   a, cy, cx, by, bx, md, mk, rr, cs, bk, wd, k, dx, dy, vx, vy, ux, uy,
                   nx, ny, dist, brg, rel, cross, along, rx, ry, vv, t, px, py, cpa, lo, hi, off,
                   sh, pos, sd, alo, ahi){
  print ""
  printf "  %s\n", cw("A REPORTED STORM", C_ACC)
  hr()
  a = st_num(age); cy = st_deg(clat, 90); cx = st_deg(clon, 180); md = st_num(mdir); mk = st_num(mkn)
  rr = st_num(r34); by = st_deg(blat, 90); bx = st_deg(blon, 180); cs = st_num(bcse); bk = st_num(bkn); wd = st_num(wind)
  if(a == "" || clat == "" || clon == "" || md == "" || mk == "" || blat == "" || blon == ""){
    ch_say("Give me the advisory - how many hours ago it was issued, the centre's")
    ch_say("latitude and longitude, its direction and speed of movement - and your")
    ch_say("own position, and I will set it beside your wind.")
    print ""
    return 0
  }
  if(a == "x" || a < 0){ ch_say("The advisory's age is a number of hours, 0 or more."); print ""; return 0 }
  if(cy == "x" || by == "x"){ ch_say("A latitude runs from 90 S to 90 N: a number, or one with N or S after it."); print ""; return 0 }
  if(cx == "x" || bx == "x"){ ch_say("A longitude runs from 180 W to 180 E: a number, or one with E or W after it."); print ""; return 0 }
  if(md == "x" || md < 0 || md >= 360 || mk == "x" || mk < 0){ ch_say("The movement is a direction, 0 to 359, and a speed in knots."); print ""; return 0 }
  if(rr == "x" || (rr != "" && rr < 0)){ ch_say("The 34-knot radius is in nautical miles; leave it out if the advisory has none."); print ""; return 0 }
  if(cs == "x" || bk == "x" || (cs != "" && (cs < 0 || cs >= 360)) || (bk != "" && bk < 0)){ ch_say("Your course is 0 to 359 and your speed knots; leave both out if you are stopped."); print ""; return 0 }
  if(wd == "x" || (wd != "" && (wd < 0 || wd >= 360))){ ch_say("Your wind is the direction it blows from, 0 to 359; leave it out if you have none."); print ""; return 0 }
  if((by < 0 && cy > 0) || (by > 0 && cy < 0)){
    ch_say(cw("You and the storm are on opposite sides of the equator.", C_WARN))
    ch_why("its side and its wind turn the other way across it: not worked")
    print ""
    return 0
  }
  #  the storm's hemisphere: 1 north, -1 south
  sh = (cy < 0 || (cy == 0 && by < 0)) ? -1 : 1
  pos = 0
  if(cs == "") cs = 0; if(bk == "") bk = 0
  k = cos((cy + by) / 2 * 3.141592653589793 / 180)
  dx = cx - bx; if(dx > 180) dx -= 360; if(dx < -180) dx += 360
  dx = dx * 60 * k; dy = (cy - by) * 60
  vx = mk * sin(md * 3.141592653589793 / 180); vy = mk * cos(md * 3.141592653589793 / 180)
  ux = bk * sin(cs * 3.141592653589793 / 180); uy = bk * cos(cs * 3.141592653589793 / 180)
  nx = dx + vx * a; ny = dy + vy * a
  dist = sqrt(nx * nx + ny * ny); brg = atan2(nx, ny) * 57.29577951308232
  ch_say(sprintf("Reported %g hours ago: the centre at %s, %s, moving %03d at %g knots.", a, st_ll(cy, "N", "S"), st_ll(cx, "E", "W"), st_b(md), mk))
  if(rr != "") ch_say(sprintf("Its 34-knot winds reach %g nm from the centre.", rr))
  ch_say(sprintf("You: %s, %s, %s.", st_ll(by, "N", "S"), st_ll(bx, "E", "W"), (bk > 0 ? sprintf("steering %03d at %g knots", st_b(cs), bk) : "stopped")))
  print ""
  ch_say(cw(sprintf("The centre now: %03d, %d nm from you.", st_b(brg), st_r(dist)), C_ACC))
  ch_why(sprintf("the advisory's position moved on %g hours along its track", a))
  #  the side: you from the centre, against the way it goes
  if(mk > 0){
    rel = atan2(-nx, -ny) * 57.29577951308232 - md
    cross = dist * sin(rel * 3.141592653589793 / 180); along = dist * cos(rel * 3.141592653589793 / 180)
    off = (cross < 0 ? -cross : cross)
    pos = (along > 0 ? 1 : (along < 0 ? -1 : 0))
    #  ON ITS TRACK: under half a mile off it, where the sign of a
    #  cross product is only rounding, it is neither side
    if(off < 0.5){
      ch_say(cw(sprintf("You are on its track, %s it.", (along > 0 ? "ahead of" : "behind")), C_WARN))
      ch_why("neither side: ahead of it the centre is coming at you, behind")
      ch_why("it the centre is going away (Bowditch)")
    } else {
      sd = (cross > 0 ? "right" : "left")
      if((sh > 0) == (cross > 0)){
        ch_say(cw(sprintf("You are on the %s of its track, %d nm off it: the dangerous side.", sd, st_r(off)), C_WARN))
        ch_why("north of the equator its right is the dangerous side; south of it,")
        ch_why("its left. Its own speed adds to its wind there, and the wind and sea")
        ch_why("carry you toward its path (Bowditch)")
      } else {
        ch_say(sprintf("You are on the %s of its track, %d nm off it: the navigable side.", sd, st_r(off)))
        ch_why("the navigable side is not safe, only less dangerous. Its speed takes")
        ch_why("from its wind there, and the wind carries you away from its path")
        ch_why("(Bowditch)")
      }
      ch_why("look the way the storm is going: on its right the wind veers, on its")
      ch_why(sprintf("left it backs. Here, expect yours to %s as it passes", (cross > 0 ? "veer" : "back")))
    }
    #  NEAR ITS PATH: ahead of it and within its 34-knot radius of the
    #  track (30 nm when the advisory gives no radius), the app's own line
    if(along > 0 && ((rr != "" && off < rr) || (rr == "" && off < 30)))
      ch_say(cw("And you are ahead of it, near its path: its winds reach your water.", C_WARN))
  } else ch_say("It is reported stationary, so it has no track to be either side of.")
  print ""
  #  the closest approach, both holding course and speed
  rx = vx - ux; ry = vy - uy; vv = rx * rx + ry * ry
  if(vv < 0.25){
    ch_say(sprintf("It is keeping its distance from you: about %d nm while both hold on.", st_r(dist)))
  } else {
    t = -(nx * rx + ny * ry) / vv
    if(t <= 0){
      ch_say("It is drawing away from you: its closest was before now.")
      if(rr != "" && dist < rr) ch_say(cw("You are inside its 34-knot winds.", C_WARN))
    } else {
      px = nx + rx * t; py = ny + ry * t; cpa = sqrt(px * px + py * py)
      if(cpa < 0.5) ch_say(cw(sprintf("If both hold on, its centre passes over you in %d hours.", st_r(t)), C_WARN))
      else ch_say(cw(sprintf("If both hold on, it comes closest in %d hours: %d nm, bearing %03d.", st_r(t), st_r(cpa), st_b(atan2(px, py) * 57.29577951308232)), C_ACC))
      if(rr != ""){
        if(dist < rr) ch_say(cw("You are inside its 34-knot winds now.", C_WARN))
        else if(cpa < rr) ch_say(cw(sprintf("That is inside its 34-knot winds, which reach %g nm.", rr), C_WARN))
        else ch_say(sprintf("That is outside its 34-knot winds, which reach %g nm.", rr))
      }
      ch_why("a storm can turn, speed up or stop; work it again with each advisory")
    }
  }
  print ""
  #  your own wind
  if(wd == ""){
    ch_say("Give me your wind and I will check the report against it.")
  } else {
    if(pos > 0){ alo = 87.5; ahi = 110 } else if(pos < 0){ alo = 97.5; ahi = 135 } else { alo = 87.5; ahi = 135 }
    if(sh > 0){ lo = wd + alo; hi = wd + ahi } else { lo = wd - ahi; hi = wd - alo }
    ch_say(sprintf("Your wind from %03d puts the centre between %03d and %03d.", st_b(wd), st_b(lo), st_b(hi)))
    ch_why("face the wind: north of the equator the centre is about 110 degrees to")
    ch_why("your right ahead of the storm, and 120 to 135 behind it; south of the")
    ch_why("equator, to your left. Nearer the centre, a point or two less (Bowditch)")
    if(pos > 0)      ch_why("you are ahead of it: 110, or a point or two less")
    else if(pos < 0) ch_why("you are behind it: 120 to 135, or a point or two less")
    else             ch_why("it has no track to be ahead of or behind: 110 to 135, or two points less")
    #  UNDER HALF A DEGREE OUTSIDE IS INSIDE (weather 1.0.22, found by the
    #  shared storm cases, TAYT): the bearing and the band are printed to
    #  the whole degree, so a centre 0.4 degrees past the band's edge used
    #  to read "0 degrees outside that: near enough".  Now it agrees.
    off = st_out(brg, lo, hi)
    if(st_r(off) == 0) ch_say(cw("The report agrees with your wind.", C_ACC))
    else if(off <= 15) ch_say(sprintf("The report is %d degrees outside that: near enough, for a wind read by eye.", st_r(off)))
    else {
      ch_say(cw(sprintf("The report and your wind disagree, by %d degrees.", st_r(off)), C_WARN))
      ch_why("one of them is wrong or old: the advisory's age, a storm that has")
      ch_why("turned, or your log. The wind on deck is the newer evidence.")
    }
  }
  print ""
  hr()
  ch_say("Not a forecast. An advisory is hours old when it arrives, and a storm")
  ch_say("can turn; plot each one as it comes (Bowditch). Worked on a flat chart")
  ch_say("round you: good to a few miles within a few hundred.")
  print ""
  return 0
}
#  how far a bearing lies outside a band, lo clockwise to hi; 0 inside
function st_out(b, lo, hi,   w, d, e){
  w = ((hi - lo) % 360 + 360) % 360
  d = ((b - lo) % 360 + 360) % 360
  if(d <= w) return 0
  e = 360 - d
  return (d - w < e ? d - w : e)
}
function st_ll(v, p, n){ return sprintf("%g %s", (v < 0 ? -v : v), (v < 0 ? n : p)) }
# =====================================================================
#  weather -- the lessons.
#
#  THE ORGANISING RULE, and it is the reason this file is not longer:
#
#     Every piece of physics has to earn its place by changing what the
#     app says or what you would do.  Otherwise it is a lecture with a
#     barometer attached.
#
#  Ordered from what you can see today outward to why the planet works
#  this way.  Each lesson ends with a question, as in colregs.
#  Sources are in docs/SOURCES.md; nothing here is copied from anywhere.
# =====================================================================

function les_init(){
  if(LES_READY) return
  LS_N=0
  les("fluid",    "Air is a fluid, and moist air is lighter")
  les("data",     "The three kinds of weather data, and which one you have")
  les("runs",     "Run time and valid time, always in UTC")
  les("models",   "Global and high-resolution models, and how far to trust them")
  les("routing",  "Routing: what a router does, and how far to trust it")
  les("tide",     "The atmospheric tide: why the glass falls every afternoon")
  les("coriolis", "Coriolis, which is not a force")
  les("gradient", "Gradient wind, surface wind, and friction")
  les("veer",     "Backing and veering, and why the south is the other way round")
  les("fronts",   "Fronts: what passes over you, and in what order")
  les("lapse",    "Lapse rates, stability, and where the cloud base is")
  les("cells",    "The heat engine, and the three cells")
  les("h500",     "The 500 millibar chart and the 564 line")
  les("cyclone",  "How a tropical cyclone is made, and how to keep away")
  les("seasons",  "The tilt, the seasons, and an honest boundary")
  LES_READY=1
  return 0
}
function les(k,t){ LS_N++; LS_K[LS_N]=k; LS_T[LS_N]=t; return 0 }

#  THE SHORT FORM OF THE VEER LESSON, for any lesson that benefits from
#  hearing it again (Larry, 16 November 2026: "tell them once, tell them
#  twice, tell them as many times as you need").
function veer_repeat(){
  lp(cw("Backed and veered, again.",C_ACC) " The surface wind always turns toward")
  lp("the low. In the north the low is on the wind's left, so the turn is")
  lp("anticlockwise - backed. In the south it is on the right, so the turn is")
  lp("clockwise - veered. More in the lesson " cw("veer",C_ACC) ".")
  print ""
  return 0
}

function lp(s){ printf "  %s\n", s; return 0 }
function lpd(s){ printf "  %s\n", cwd(s); return 0 }
function lph(s){ print ""; printf "  %s\n", cw(s,C_ACC); hr(); return 0 }

function lesson_body(k){
  # ------------------------------------------------------------------
  if(k=="fluid"){
    lph("AIR IS A FLUID, AND MOIST AIR IS LIGHTER")
    lp("Air is a fluid. At the speeds anything on a boat moves it barely")
    lp("compresses, so it behaves very much like water - and the weather is")
    lp("fluid dynamics happening to a very large, very thin bath.")
    print ""
    lp(cw("And here is the counterintuitive one:",C_ACC))
    print ""
    lp("  " cw("Warm MOIST air is LIGHTER than warm DRY air.",C_ACC))
    print ""
    lp("Humid air feels heavy. It is not. At the same temperature and pressure")
    lp("a given volume holds a fixed NUMBER of molecules - so water vapour does")
    lp("not add molecules to the box, it " cw("replaces",C_ACC) " them:")
    print ""
    lp("       H2O  18      pushing out      N2  28")
    lp("                                     O2  32")
    print ""
    lp("Every water molecule that goes in evicts something heavier. Same count,")
    lp("less mass, lower density.")
    print ""
    lp(cw("This is the engine of everything else.",C_ACC) " Warm moist air is buoyant")
    lp("twice over - once for being warm, once for being wet - which is why the")
    lp("tropics convect so violently, and why a thunderstorm is a heat engine")
    lp("rather than a wind event.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="data"){
    #  W30 (weather 1.0.17; book of work B22, at the XO's word under rule
    #  16): brought up to the sources read on 18 November 2026 (TAUW) and
    #  given the part the gap list said was missing, how to tell which of
    #  the three you are holding.  Bowditch 2017, art. 3826, p. 631; NOAA's
    #  Unified Surface Analysis Manual; NOAA NCEI's GFS page; ECMWF's
    #  ecCodes time keys.  docs/SOURCES.md has each.
    lph("THE THREE KINDS OF WEATHER DATA")
    lp("Most sailors never learn this, and it decides how much to believe.")
    print ""
    lp(cw("OBSERVATION",C_ACC) "   an instrument reading of what is happening now:")
    lp("              your barometer, a buoy, a ship's report.")
    lp("              Not a forecast - but it is " cw("true",C_ACC) ".")
    print ""
    lp(cw("ANALYSIS",C_ACC) "      a chart drawn " cw("by forecasters",C_ACC) " from the observations,")
    lp("              with the fronts on it; a model is used only where")
    lp("              other evidence agrees. A surface analysis. The best")
    lp("              picture of the weather " cw("at its time",C_ACC) " - and it reaches")
    lp("              you a few hours after that time.")
    print ""
    lp(cw("MODEL OUTPUT",C_ACC) "  a computer's projection. What sailors call a GRIB.")
    lp("              " cw("Straight from the model: no forecaster has drawn",C_NO))
    lp("              " cw("or checked it.",C_NO))
    print ""
    lp("The trap is the third. A GRIB arrives in colour, at high resolution, out")
    lp("to sixteen days, looking authoritative - and the further ahead it reads")
    lp("the less sure it is. Sailors treat it as gospel.")
    print ""
    lph("HOW TO TELL WHICH YOU ARE HOLDING")
    lp("  " cw("two times on it",C_ACC) "     a run time and a later valid time (a step,")
    lp("                      +24 h, T+24): a model's forecast")
    lp("  " cw("step zero",C_ACC) "           the model's own starting picture - a")
    lp("                      computer's analysis, not a forecaster's")
    lp("  " cw("ANALYSIS, fronts",C_ACC) "    one time, already past, fronts drawn in:")
    lp("                      a forecasters' surface analysis")
    lp("  " cw("a place and a time",C_ACC) "  a reading from an instrument: an observation")
    print ""
    lp(cw("And it places this tool honestly.",C_ACC) " It works entirely in the first")
    lp("column. Every number in it is something you measured. It never")
    lp("forecasts from a model - but what it reasons FROM is the one category")
    lp("that is never wrong, and the only one still there when the antenna")
    lp("comes down.")
    print ""
    lpd("Bowditch, The American Practical Navigator, 2017, art. 3826; NOAA,")
    lpd("the Unified Surface Analysis Manual.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="runs"){
    #  W31 (weather 1.0.18; book of work B22, at the XO's word under rule
    #  16): run time and valid time, in the words agreed with PILOT on 19
    #  November 2026, so that this lesson and the course's forecast models
    #  page say the same thing.  Lines 1 and 2: ECMWF's ecCodes time keys
    #  (the example is the race-morning GRIB itself); line 4: NOAA NCEI's
    #  GFS page; line 5: Bowditch 2017, art. 3826, p. 631.  The last
    #  paragraph is the app's own (gap list rule 3).  docs/SOURCES.md.
    lph("RUN TIME AND VALID TIME")
    lp(cw("Every forecast has two times.",C_ACC) " The " cw("run time",C_ACC) " is when the model")
    lp("started: it begins from its picture of the weather at that moment.")
    lp("The " cw("valid time",C_ACC) " is the moment the forecast describes.")
    print ""
    lp("    " cw("valid time  =  run time  +  the step (the forecast hour)",C_ACC))
    print ""
    lp("The GFS run of 00:00 UTC on 24 May 2025 at step 27 is valid at")
    lp("03:00 UTC on 25 May: the hour the trough reached Lyme Bay.")
    print ""
    lp("    run    00Z 24 May  ---- step 27 h ---->  valid  03Z 25 May")
    print ""
    lp(cw("Always UTC.",C_ACC) " Run and valid times are in UTC (Z). Ship's time is")
    lp("yours to work out: in May, British Summer Time is UTC + 1.")
    print ""
    lp(cw("How often.",C_ACC) " GFS runs four times a day, at 00, 06, 12 and 18 UTC,")
    lp("and its files go out to 16 days, three-hourly. A run reaches you")
    lp("some hours after its run time.")
    print ""
    lp(cw("Further ahead is less sure.",C_ACC) " The further ahead the valid time,")
    lp("the less sure the forecast: a 12-hour forecast is likely to be better")
    lp("than a 24-hour one (Bowditch). " cw("Check which run you are holding, and",C_WARN))
    lp(cw("how far ahead of it you are reading.",C_WARN))
    print ""
    lp(cw("And this tool?",C_ACC) " bashnav weather never forecasts from a model. It")
    lp("reasons from what you observe, and it helps you read a model you got")
    lp("elsewhere.")
    print ""
    lpd("ECMWF, ecCodes, the time keys; NOAA NCEI, the Global Forecast")
    lpd("System; Bowditch, The American Practical Navigator, 2017, art. 3826.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="models"){
    #  W29 (weather 1.0.19; book of work B22, at the XO's word under rule
    #  16): global against high-resolution, judging a model, and when to
    #  look, following the course's forecast models page (practical-
    #  navigator, site/drafts/forecast-models) so the two say the same
    #  thing.  Sources read 19 November 2026: the Met Office's numerical
    #  models page (grids; the UKV's edges from the global model; why a
    #  fine grid matters near coasts and hills); ECMWF's Forecast User
    #  Guide 8.1.2 (spread and accuracy); NWS Juneau's brochure (comparing
    #  runs and centres; low spread, high confidence); NOAA NCEI's GFS
    #  page.  docs/SOURCES.md has each.  Gap list rule 3: the last
    #  paragraph says the app never forecasts from a model.
    lph("GLOBAL AND HIGH-RESOLUTION MODELS")
    lp("A " cw("global",C_ACC) " model covers the whole earth on a coarse grid and looks a")
    lp("week or more ahead. A " cw("regional or high-resolution",C_ACC) " model covers one")
    lp("area on a much finer grid, for a day or two, starting from a global")
    lp("model at its edges.")
    print ""
    lp("  GFS (NOAA)          the whole earth       about 28 km apart")
    lp("  UKV (Met Office)    the UK and Ireland    1.5 km apart")
    print ""
    lph("THE RULE, IN TWO PARTS")
    lp(cw("The big picture: global models.",C_ACC) " The lows, highs and fronts, and")
    lp("when they arrive. They see the whole ocean and look far enough ahead,")
    lp("so the passage is planned on them.")
    print ""
    lp(cw("The local detail: high-resolution models.",C_ACC) " Near the coast and the")
    lp("land, in the last day or two: headlands, sea breezes, wind bent round")
    lp("high ground.")
    print ""
    lp("  " cw("Never the other way round.",C_WARN))
    print ""
    lp("Why: a high-resolution model's edges come from a global one, so it")
    lp("cannot know the synoptic story better than its parent, and it does")
    lp("not look far enough ahead to plan a passage on.")
    print ""
    lph("WHAT A MODEL CANNOT SEE")
    lp(cw("Anything smaller than a few grid boxes.",C_ACC) " GFS's points are about")
    lp("28 km apart: a sea breeze, a headland, the lull under a cliff are all")
    lp("smaller.")
    print ""
    lp(cw("Gusts.",C_ACC) " A model's wind is an average over its box and its step.")
    print ""
    lp(cw("The exact hour.",C_ACC) " A front may come hours early or late, and the")
    lp("error grows the further ahead the run looks.")
    print ""
    lph("JUDGING ONE")
    lp("  " cw("between runs",C_ACC) "     the same model, run after run: if the low")
    lp("                   arrives at the same time each run, believe it more")
    lp("  " cw("between models",C_ACC) "   GFS and ECMWF agree: confidence rises. Where")
    lp("                   they disagree, the race is likely decided there")
    lp("  " cw("the ensemble",C_ACC) "     one model run many times from slightly")
    lp("                   different starts: a tight bunch, confidence;")
    lp("                   a wide spread, low confidence")
    lp("  " cw("your own log",C_ACC) "     if the model is already wrong about now,")
    lp("                   it will be wrong about later")
    print ""
    lph("WHEN TO LOOK")
    lp("  " cw("5 to 7 days",C_ACC) "      the big picture: which systems, and is the")
    lp("                   global models' story steady?")
    lp("  " cw("2 days",C_ACC) "           the timing: when do the fronts and shifts")
    lp("                   arrive, and do the models agree?")
    lp("  " cw("race morning",C_ACC) "     the detail: the latest runs against the")
    lp("                   plan, and high-resolution models for the coast")
    lp("  " cw("at sea",C_ACC) "           only what the race allows aboard, checked")
    lp("                   against your own observations")
    print ""
    lp(cw("And this tool?",C_ACC) " bashnav weather never forecasts from a model. It")
    lp("keeps the observations you judge one against: your glass, your")
    lp("wind, your sky.")
    print ""
    lpd("The Met Office, numerical weather prediction models; ECMWF, Forecast")
    lpd("User Guide 8.1.2; NWS Juneau, Numerical Weather Prediction; NOAA")
    lpd("NCEI, the Global Forecast System.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="routing"){
    #  W35 (weather 1.0.21; book of work B22; Larry's ruling TAYO, 19
    #  November 2026): what a router does and how far to trust it, with a
    #  figure at each point (Larry: "many, spaced through the lesson at
    #  each key point").  The figures are worked on the made-up boat of
    #  rt_init() in wx.awk; the last one is the course's three runs of
    #  bashnav's own router.  Sources read 19 November 2026 and recorded
    #  in docs/SOURCES.md: NOAA SciJinks (how often a forecast is right);
    #  LuckGrib's routing manual and bashnav's ROUTER.md (isochrones);
    #  Stan Honey's Pacific Cup article and talks (reverse isochrones,
    #  the router's bias, scaling, saying the route in sailing terms);
    #  Frank Singleton's GRIB notes (the wind reads low); the course's
    #  routing page.  Gap list rule 3: the lesson says the app does not
    #  route.
    lph("ROUTING: WHAT A ROUTER DOES")
    lp("A router takes two things: a " cw("forecast",C_ACC) " of the wind everywhere, hour")
    lp("by hour (and the tidal stream, where there is one), and a " cw("polar",C_ACC) ",")
    lp("the table of how fast the boat sails at each wind speed and angle. It")
    lp("answers one question: by what track could she finish soonest?")
    print ""
    lp("It works outward from the start. She is sent off on every heading")
    lp("for one step of time, at the speed the polar gives. The far edge of")
    lp("where those boats get to is an " cw("isochrone",C_ACC) ": every place she could")
    lp("have reached by that time. From that edge it does the same again,")
    lp("until an isochrone reaches the finish. The route is read backwards")
    lp("from there, through one point on each isochrone.")
    print ""
    rt_fan_figure()
    gshow()
    print ""
    lp("Here the wind is the same everywhere, so each isochrone is the last")
    lp("one grown bigger. In real weather they bend. Where an isochrone")
    lp("bulges toward the finish, the wind or the stream on that side is")
    lp("paying.")
    print ""
    lph("HOW FAR AHEAD: THE FIVE-DAY HORIZON")
    lp("A route is only as good as its forecast, and a forecast fades. NOAA")
    lp("puts a five-day forecast right about nine times in ten, a seven-day")
    lp("one about eight in ten, and one for ten days or more about half the")
    lp("time.")
    print ""
    rt_horizon_figure()
    gshow()
    print ""
    lp(cw("So route on about five days.",C_ACC) " Past that the route is a sketch of")
    lp("what may come, to be drawn again with each new run.")
    print ""
    lph("REVERSE ISOCHRONES: WHAT A PLACE COSTS")
    lp("Run the same sum backwards from the finish and you have " cw("reverse",C_ACC))
    lp(cw("isochrones",C_ACC) ": every place from which she could still finish in so")
    lp("many hours. Lay them over the forward ones. At any place, the hours")
    lp("to get there plus the hours to finish from there is the time of a")
    lp("route through that place. Where that sum stays close to the best, it")
    lp("hardly matters where you are: a don't-care area. Where it climbs fast,")
    lp("the route is a narrow lane.")
    print ""
    rt_lane_figure()
    gshow()
    print ""
    lp("On the reach, the water that costs under ten minutes is a lane")
    lp(sprintf("%.1f miles wide. On the beat it is %.1f miles wide: in a steady wind,", rt_width(RT_REACH, 0, RT_LANE), rt_width(0, RT_BEAT, RT_LANE)))
    lp("anywhere between the laylines takes the same time. " cw("Look before you",C_ACC))
    lp(cw("fight for a side.",C_ACC) " Inside a wide lane you can sail for the crew, the")
    lp("sea or the other boats at little cost. On that beat, the router's")
    lp("side is only worth what the shift it expects is worth.")
    print ""
    lph("THE MOTORBOAT: WHAT THE WIND COSTS")
    lp("A motorboat goes the same speed on every heading, so in still water")
    lp("her fastest course is the straight line. Set her beside the sailing")
    lp("route and the difference is what the wind asks of you: extra miles.")
    print ""
    rt_motor_figure()
    gshow()
    print ""
    lp(cw("Extra miles are what a route spends.",C_ACC) " Know how many, and what they")
    lp("buy. The Practical Navigator course does this with bashnav's own")
    lp("motorboat: straight lines between the routed boat's places, in her")
    lp("times, to show what the tide and the wind each add.")
    print ""
    lph("WHERE A ROUTER IS BIASED")
    lp(cw("It believes the forecast completely.",C_ACC) " A shift forecast for 02:00 is,")
    lp("to the router, a fact, to the minute.")
    print ""
    lp(cw("Its boat sails the polar, always.",C_ACC) " A steady wind, a perfect helm, a")
    lp("fresh crew, and never a bad hour.")
    print ""
    lp(cw("It goes all in.",C_ACC) " If one side is a minute faster, it takes that side,")
    lp("however much it would lose were the forecast a little out. " cw("It measures",C_WARN))
    lp(cw("time, never risk.",C_WARN))
    print ""
    rt_allin_figure()
    gshow()
    print ""
    lp(sprintf("Here the forecast has the wind veering %d degrees, an hour into a", RT_SHIFT))
    lp(sprintf("%d-mile beat. The router goes right, all the way, and is %d minutes", RT_BEAT, rt_min(rt_allin(0.5, RT_SHIFT)) - rt_min(rt_allin(1, RT_SHIFT))))
    lp("up on the boat in the middle - if the veer comes. If the wind backs")
    lp(sprintf("instead she is %d minutes behind the middle, and %d behind the boat", rt_min(rt_allin(1, -RT_SHIFT)) - rt_min(rt_allin(0.5, -RT_SHIFT)), rt_min(rt_allin(1, -RT_SHIFT)) - rt_min(rt_allin(0, -RT_SHIFT))))
    lp(sprintf("that went left. The middle is never more than %d minutes from the", rt_min(rt_allin(0.5, RT_SHIFT)) - rt_min(rt_allin(1, RT_SHIFT))))
    lp("best. The router cannot see that. You can.")
    print ""
    lph("SCALE THE WIND AND THE STREAM")
    lp("A model's wind is an average over its grid, and over the open sea it")
    lp("reads low: by about a Beaufort force, or 20 percent, in one")
    lp("forecaster's account. The ocean navigator Stan Honey's rule of thumb")
    lp("is to route on the GRIB's wind " cw("times 1.15 in the tropics, 1.20 in",C_ACC))
    lp(cw("mid-latitudes and 1.25 in high latitudes",C_ACC) ", and on the stream " cw("times",C_ACC))
    lp(cw("1.30",C_ACC) "; then to correct both to what is measured on deck.")
    print ""
    rt_scale_figure()
    gshow()
    print ""
    lp("Your own log is the better guide: if the GRIB said 20 and you have")
    lp("logged 24 all day, 24 is your number. bashnav's router takes this as")
    lp("one line of a run: " cw("scale wind 1.2 current 1.3",C_ACC) ".")
    print ""
    lph("TEST THE ROUTE")
    lp("Change what the router was told, and see whether the route changes.")
    print ""
    lp("  " cw("the wind",C_ACC) "       lighter, and stronger")
    lp("  " cw("the forecast",C_ACC) "   the next run, and another model")
    lp("  " cw("the timing",C_ACC) "     the weather arriving sooner, and later")
    lp("  " cw("the stream",C_ACC) "     switched off, to see what it was worth")
    print ""
    lp(cw("A route that holds is one to trust.",C_ACC) " A route that swaps sides is")
    lp("one to hold loosely, and where it swaps is where you must be awake.")
    print ""
    rt_whatif_figure()
    gshow()
    print ""
    lp("So the call in Lyme Bay is one to trust, as far as the wind's")
    lp(sprintf("strength goes; the finishing time is not, by %s. " cw("And the test has",C_ACC), rt_hm(RT_RUN[3] - RT_RUN[11])))
    lp(cw("a limit.",C_ACC) " Scaling the speed leaves every shift at the forecast's own")
    lp("time. Testing the timing takes another run or another model.")
    print ""
    lph("SAY IT IN SAILING TERMS")
    lp("You are not done until you can explain the route to the watch in")
    lp("sailors' words. For that night in Lyme Bay:")
    print ""
    lp("  " cw("what we are doing",C_ACC) "    port tack up into the bay, for four hours")
    lp("  " cw("why",C_ACC) "                  the wind is forecast to veer, and a veer")
    lp("                       lifts starboard tack")
    lp("  " cw("what we expect",C_ACC) "       the wind at its strongest near midnight,")
    lp("                       then the first degrees of veer")
    lp("  " cw("what we do then",C_ACC) "      tack when it has veered 15 degrees and held")
    lp("  " cw("if it does not come",C_ACC) "  no veer by 04:00, or it backs: call the")
    lp("                       navigator")
    print ""
    lp("If you cannot say it that way you do not yet understand the route,")
    lp("and should not sail it.")
    print ""
    lp(cw("And this tool?",C_ACC) " bashnav weather does not route, and never forecasts")
    lp("from a model. It keeps the other voices: your glass, your wind, your")
    lp("sky and your log, which are what a route is tested against at sea.")
    lp("bashnav's router sails the Practical Navigator course's races.")
    print ""
    lpd("NOAA SciJinks, how reliable are weather forecasts; LuckGrib, the")
    lpd("routing manual; Stan Honey, Pacific Cup Weather and Tactics, and")
    lpd("his navigator's talks (honeynav.com); Frank Singleton, a note on")
    lpd("GRIB files; the Practical Navigator course, the routing page.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="tide"){
    lph("THE ATMOSPHERIC TIDE")
    lp("The sun heats the air, the earth turns under it, and a pressure wave")
    lp("travels westward with the sun. It is on your barometer, every day.")
    print ""
    lp("The odd part: the dominant component is " cw("SEMIdiurnal - twice a day",C_ACC) ",")
    lp("not once. Why once-a-day heating produces a twice-a-day pressure signal")
    lp("is a genuine puzzle in meteorology.")
    print ""
    lp("  size in the tropics          about 1.4 hPa each way")
    lp("  maxima                       about 1000 and 2200 local")
    lp("  minima                       about 0400 and " cw("1600",C_ACC) " local")
    #  THE SIZES ARE THE WORKING'S (Larry, AOR, 17 November 2026).  The
    #  correction in wx.awk is 1.4 * cos^3(latitude) hPa each way: 1.4 at
    #  the equator, 0.5 at 45 degrees, 0.4 at 50.  Until weather 1.0.6
    #  this line said "~1.2 hPa at the equator, ~0.2 at 45 deg", which
    #  the working never did; a lesson must quote the rule the app
    #  applies.  The tropics' size is Bowditch's (American Practical
    #  Navigator, 2002, art. 3506: "about 3 hPa", top to bottom).  The
    #  fall-off with latitude is not yet confirmed from a source read
    #  (docs/SOURCES.md, Weather).
    lp("  falling off with latitude    1.4 hPa at the equator, 0.5 at 45 deg")
    print ""
    lpd("The tropics' size is Bowditch's: about 3 hPa from top to bottom, so")
    lpd("1.4 each way. The fall-off with latitude is the rule this app uses.")
    print ""
    lp(cw("Which is a trap worth knowing about.",C_WARN) " In the tropics the glass")
    lp("falls two to three millibars between mid-morning and mid-afternoon")
    lp(cw("every single day, in perfect weather.",C_ACC) " A sailor who does not know")
    lp("that reads a routine afternoon fall as a system approaching.")
    print ""
    lpd("This app corrects for it before saying anything about tendency, and")
    lpd("tells you how much of the change was the tide. Give it your longitude")
    lpd("- it needs local solar time to know where in the cycle you are.")
    print ""
    lp("In the browser, the barograph on " cw("What the log says",C_ACC) " draws this wave")
    lp("behind your own readings. A trace that follows the wave is only the")
    lp("tide; one that leaves it is weather.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="coriolis"){
    lph("CORIOLIS, WHICH IS NOT A FORCE")
    lp("The earth turns underneath you. Describe anything's motion relative to")
    lp("the ground and it appears to curve. The \"force\" is the bookkeeping")
    lp("entry for having chosen a rotating frame - nothing is pushing.")
    print ""
    lp("Its size goes as " cw("sin(latitude)",C_ACC) ":")
    print ""
    lp("  at the poles     full strength")
    lp("  at 45 degrees    about 0.7 of it")
    lp("  " cw("at the equator   ZERO",C_ACC))
    print ""
    #  WHERE THE SINE COMES FROM.  The lesson asserted sin(latitude) and
    #  stopped, which is the one question a thoughtful reader asks of it --
    #  Larry did, and arrived at the earth's oblateness, which is not the
    #  reason and would not matter on a perfectly round planet.  Both
    #  derivations are given because the second is the one that makes the
    #  result feel inevitable rather than remembered.
    lp(cw("Where the sine comes from",C_ACC) ", because it is not arbitrary:")
    print ""
    lp("The earth's spin points along its axis. What can deflect something")
    lp("moving HORIZONTALLY is only the part of that axis pointing straight")
    lp("UP where you are standing - and that part is sin(latitude) of it.")
    print ""
    lp("  at the pole      the axis IS straight up, so all of it counts")
    lp("  at the equator   the axis lies flat along your horizon, so none")
    print ""
    lp("Nothing about the shape of the earth comes into this. It would be")
    lp("exactly the same on a perfect sphere.")
    print ""
    lp("The same answer from the other side, which is the one that makes it")
    lp("feel inevitable: what matters to a moving parcel is how far it is")
    lp("from the AXIS, and that goes as cos(latitude). At the equator cos is")
    lp("at its maximum, so it is " cw("flat",C_ACC) " there - move a few degrees north or")
    lp("south and your distance from the axis barely changes, so your spin")
    lp("barely changes, so there is nothing to turn you.")
    print ""
    lp("And read that ZERO honestly. At 5 degrees the factor is sin 5, which")
    lp("is 0.09 - under a tenth of polar strength. " cw("Small, not absent",C_ACC) ". The")
    lp("five degree rule below is a threshold for getting a storm started,")
    lp("not a line where the physics switches off.")
    print ""
    lp(cw("Two consequences: where a cyclone cannot form, and which way",C_ACC))
    lp(cw("to turn for the low.",C_ACC))
    print ""
    lp("First: " cw("no tropical cyclone forms within about 5 degrees of the",C_ACC))
    lp(cw("equator",C_ACC) ", because there is too little there to spin it up. All that")
    lp("heat and moisture, and not enough rotation to organise it.")
    print ""
    lp("Second: it is half of Buys Ballot, which is the most useful rule this")
    lp("app has. Stand with your back to the wind and the low is on your left")
    lp("in the northern hemisphere - and on your right in the southern, because")
    lp("the sense of the rotation reverses.")
    print ""
    veer_repeat()
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="gradient"){
    lph("GRADIENT WIND, SURFACE WIND, AND FRICTION")
    lp("Well above the sea the wind balances the pressure gradient against")
    lp("Coriolis and runs " cw("along",C_ACC) " the isobars. That is the gradient wind, and")
    lp("it is what a weather chart draws.")
    print ""
    lp("Down where you are, friction slows the air. Slower air feels less")
    lp("Coriolis. So pressure wins a little, and the surface wind blows")
    lp(cw("across",C_ACC) " the isobars, toward the low:")
    print ""
    lp("  over water   backed 10-20 degrees, and about 2/3 of gradient speed")
    lp("  over land    backed 30-40 degrees, and 1/3 to 2/3 of gradient speed")
    lp("  " cw("southern hemisphere: veered, not backed",C_ACC))
    print ""
    lp("How much the land slows it depends on the ground. Open fields and")
    lp("farmland drag least; forests, towns and cities, with their trees and")
    lp("buildings, drag most, and turn the wind further across the isobars.")
    lpd("These are rules of thumb. The sources disagree on the land figure,")
    lpd("from 1/3 (Royal Meteorological Society) to 2/3 (US Navy training).")
    print ""
    veer_repeat()
    friction_figure()
    gshow()
    print ""
    lp(cw("How strong, from the chart.",C_ACC) " The gradient wind's speed comes from")
    lp("how close the isobars are: the closer they are, the harder the push")
    lp("toward the low and the stronger the wind. Nearer the equator the")
    lp("earth's turn is weaker, so the same spacing blows harder. The scale:")
    print ""
    iso_scale_figure()
    gshow()
    print ""
    lp("At 100 nm apart and 50 degrees north that is 31 knots aloft, so about")
    lp("20 on deck over the sea. Measure the gap on your own chart and the")
    lp("screen " cw("The wind from the isobars",C_ACC) " works it for you, down to the deck.")
    print ""
    lp(cw("This is the chart-to-deck translation",C_ACC) " - what the isobars mean for")
    lp("what you will actually get on the wind instrument.")
    print ""
    lp("And the same boundary layer does something else you already know about.")
    lp("Friction slows the lowest air, so wind speed climbs with height, and")
    lp("the apparent wind aloft is stronger and further aft than at the boom.")
    lp("That is why a sail is " cw("twisted",C_ACC) ". One piece of physics, two apps.")
    print ""
    lp(cw("Why it turns: three forces",C_ACC))
    lp("Three things act on the wind down here. The " cw("push",C_ACC) " from high pressure")
    lp("toward low - what the isobars show - drives it. The " cw("earth turning",C_ACC))
    lp("beneath it bends it: to the right in the north (Coriolis). And the")
    lp(cw("drag",C_ACC) " of the sea or the land slows it.")
    print ""
    lp("Aloft, with nothing to drag on, the bend grows until it matches the")
    lp("push, and the wind runs straight along the isobars. Down here the drag")
    lp("slows it, a slower wind is bent less, and the push toward the low")
    lp("wins: the wind slants in across the isobars. Drawn head to tail, the")
    lp("three close into a triangle:")
    print ""
    forces_figure()
    gshow()
    print ""
    lp("The rougher the surface, the longer the drag side and the shorter the")
    lp("bend: the wind turns further in toward the low, and slows. Over the")
    lp("sea, a little. Over towns and forests, a lot.")
    lpd("The triangle is for the lowest kilometre or so of air. On deck the")
    lpd("wind is slower again, because it drops toward the surface - the same")
    lpd("drop that twists a sail - so the rule says about 2/3 over the sea.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  #  BACKING AND VEERING (weather 1.0.2; Larry, AKI, 16 November 2026).
  #  A lesson of its own because the main screen uses the words ("Wind
  #  has VEERED 30 degrees") and the gradient lesson uses them in their
  #  other sense.  Told in a sailor's terms, light on mathematics: the aim
  #  is to understand what is happening, not to work it.  Its pieces are
  #  functions (veer_repeat here, the two figures in grid.awk) so other
  #  lessons can tell it again.
  if(k=="veer"){
    lph("BACKING AND VEERING, AND WHY THE SOUTH IS THE OTHER WAY ROUND")
    lp("Two words a sailor uses all the time, and they have two jobs.")
    print ""
    lp(cw("Over time",C_ACC) ", they say which way the wind has shifted. The wind")
    lp(cw("veers",C_ACC) " when it shifts clockwise round the compass: west, then")
    lp("north-west, then north. It " cw("backs",C_ACC) " when it shifts anticlockwise:")
    lp("west, then south-west, then south.")
    print ""
    veer_time_figure()
    gshow()
    print ""
    lp("These are compass words, so they mean the same on either side of the")
    lp("equator. What changes is what a shift is telling you.")
    print ""
    lp(cw("What a shift tells you, in the north.",C_ACC) " Depressions here mostly run")
    lp("west to east. When one passes on your " cw("north",C_ACC) " side, as most do in")
    lp("the Channel, the wind " cw("veers",C_ACC) " as its fronts go through: south-west")
    lp("ahead of it, west at the warm front, north-west behind the cold front.")
    lp("When the centre passes on your " cw("south",C_ACC) " side, the wind " cw("backs",C_ACC))
    lp("steadily instead: east, north-east, north.")
    print ""
    pass_figure(1)
    gshow()
    print ""
    lp(cw("One rule covers both.",C_ACC) " Look the way the low is going. On its")
    lp(cw("right",C_ACC) " the wind " cw("veers",C_ACC) "; on its " cw("left",C_ACC) " the wind " cw("backs",C_ACC) ". A depression")
    lp("going east has its left on the north side, so a boat there has the wind")
    lp("back. A storm going west - in the trade-wind belt, before it turns - has")
    lp("its left on the south side, and a boat there has the centre pass to its")
    lp("north while the wind backs.")
    print ""
    lp(cw("South of the equator it runs the other way.",C_ACC) " The wind goes round a")
    lp("low clockwise there, so the same picture plays backwards. A low passing")
    lp("on your poleward side - the south - makes the wind " cw("back",C_ACC) ": north, then")
    lp("north-west, then south-west as the cold front comes through.")
    print ""
    pass_figure(0)
    gshow()
    print ""
    lp(cw("Against the wind aloft",C_ACC) ", the same two words describe the friction")
    lp("turn from the gradient lesson. Down where you are, the sea slows the")
    lp("wind and it turns in toward the low. In the north the low is on the")
    lp("wind's left, so turning toward it is turning anticlockwise: the surface")
    lp("wind is " cw("backed",C_ACC) " from the isobars. In the south the low is on the right,")
    lp("so the same turn is clockwise: " cw("veered",C_ACC) ".")
    print ""
    veer_hemi_figure()
    gshow()
    print ""
    lp(cw("Why the south is the other way round",C_ACC) ", without the mathematics. The")
    lp("earth turns under the moving air, and that bends anything moving: to")
    lp("its right in the north, to its left in the south. So air drawn into a")
    lp("low swings round it anticlockwise in the north and clockwise in the")
    lp("south, and the low ends up on the wind's left in one and on its right")
    lp("in the other. Friction always lets the wind slip toward the low - and")
    lp("that is backed in one hemisphere and veered in the other.")
    print ""
    lp("And the rule that carries all of it to the cockpit is Buys Ballot:")
    lp(cw("back to the wind, the low is on your left",C_ACC) " in the north, and on your")
    lp("right in the south.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  #  FRONTS (W20, weather 1.0.10; Larry, ATR, 18 November 2026).  Built
  #  on the passing low of the lesson `veer`: the same low, now with its
  #  fronts, and the same two boats either side of its track.  The words
  #  for each stage are Bowditch's (2017, 3809 to 3812), in our own words;
  #  the wind and the glass in the figure are worked from wx.awk's model.
  #  Northern hemisphere only, until Larry rules on the south's own words.
  if(k=="fronts"){
    lph("FRONTS: WHAT PASSES OVER YOU, AND IN WHAT ORDER")
    lp("A body of air takes on the character of where it sat: cold or warm,")
    lp("wet over the sea or dry over land. That is an " cw("air mass",C_ACC) ". Where two")
    lp("meet there is a zone of change, drawn on the chart as a line: a " cw("front",C_ACC) ".")
    print ""
    lp(cw("Why the wind shifts at a front.",C_ACC) " A front lies in a trough: the")
    lp("pressure is lower along it, so the isobars kink where they cross it.")
    lp("The wind follows the isobars, so a kink in the isobars is a shift in")
    lp("the wind. A trough with no front does the same, and that is the veer")
    lp("of the 2025 race: a trough swinging past, the isobar through the boat")
    lp("turning clockwise.")
    print ""
    lp("Here is the low from the lesson " cw("veer",C_ACC) " with its fronts on, going east.")
    lp("The boats stay put, so each runs through it, right to left.")
    print ""
    fronts_figure()
    gshow()
    print ""
    lp(cw("Boat A, on the low's right, south of its track.",C_ACC) " Both fronts pass")
    lp("over her, in this order:")
    lp("  1  The glass starts to fall. High cloud comes first, mares' tails")
    lp("     of cirrus, then a milky sheet of cirrostratus.")
    lp("  2  The cloud lowers and thickens to altostratus, then nimbostratus")
    lp("     and steady rain. The glass falls faster.")
    lp("  3  The warm front passes: the wind " cw("veers",C_ACC) ", south to south-west, the")
    lp("     rain stops and it turns warmer. In the warm sector the glass is")
    lp("     about steady; low stratus, drizzle, haze or fog are usual.")
    lp("  4  The cold front: cumulonimbus, squalls, heavy showers, perhaps")
    lp("     thunder. The wind " cw("veers",C_ACC) " sharply to north-west, the air turns")
    lp("     cold, and the glass rises, often quickly. Squalls can run up to")
    lp("     200 miles ahead of the front itself.")
    lp("  5  Behind it: cold, clear air, scattered showers, good visibility.")
    print ""
    lp(cw("Boat B, on the low's left, north of its track.",C_ACC) " No front passes over")
    lp("her. The weather changes slowly, and the wind " cw("backs",C_ACC) ": south-east,")
    lp("east-north-east, north.")
    print ""
    lp("It is the rule from the passing low, with the fronts added: looking")
    lp("the way the low goes, on its right the wind " cw("veers",C_ACC) ", in two jumps at")
    lp("the two fronts; on its left it " cw("backs",C_ACC) ", steadily.")
    print ""
    lp(cw("Later in its life",C_ACC) " the cold front catches the warm front, lifting the")
    lp("warm sector off the surface: an " cw("occluded front",C_ACC) ". The low is near its")
    lp("deepest then, and soon starts to fill.")
    print ""
    lp(cw("On a chart:",C_ACC) " a warm front has round barbs, a cold front triangles,")
    lp("both on the side it is moving toward; an occluded front has both,")
    lp("alternating; a stationary front has both, on opposite sides.")
    print ""
    lp("No two lows are alike. The figure's numbers come from a model of one")
    lp("tidy low; a real glass and a real sky are the evidence.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="lapse"){
    lph("LAPSE RATES, STABILITY, AND THE CLOUD BASE")
    lp("Air cools as it rises, because it expands. How fast is the whole game.")
    print ""
    lp("  " cw("dry adiabatic",C_ACC) "     about 3.0 C per 1000 ft   an unsaturated parcel")
    lp("  " cw("saturated",C_ACC) "         about 1.5 C per 1000 ft   condensing gives heat back")
    lp("  " cw("environmental",C_ACC) "     whatever the air actually does - measured")
    print ""
    lp("Compare the environmental rate with the adiabatic and you have")
    lp(cw("stability",C_ACC) ". If the surrounding air cools FASTER with height than the")
    lp("parcel does, the parcel stays warmer than its surroundings, keeps")
    lp("rising, and you get towering cloud. That is instability, and it is why")
    lp("a saturated parcel can keep going where a dry one would have stopped.")
    print ""
    lp(cw("THE CLOUD BASE",C_ACC) " falls straight out of it, and the arithmetic is")
    lp("something you can do on deck:")
    print ""
    lp("  a rising parcel cools at         3.0 C / 1000 ft")
    lp("  its dew point falls at           0.5 C / 1000 ft")
    lp("  " cw("so the spread closes at          2.5 C / 1000 ft",C_ACC))
    print ""
    lp("  " cw("height (ft) = (air temp - dew point, in C) x 400",C_ACC))
    print ""
    lp("400, not 333. " cw("It is not the lapse rate, it is the DIFFERENCE",C_WARN) " between")
    lp("two of them. Divide by the lapse rate alone and you put the base a")
    lp("sixth too low. And it is " cw("air",C_ACC) " temperature, not sea temperature - the")
    lp("sea is a fair proxy offshore and badly wrong near a front.")
    print ""
    #  The trade inversion (weather 1.0.20): only in the trade winds, and a
    #  lid over the moist layer that few cumulus get through (AMS Glossary,
    #  "Trade inversion"; NWS training, "Cloud-topped and marine boundary
    #  layers").  It said before that the lid was always there and that
    #  the flat tops were its underside, which no source read gives.
    lp("A field of cumulus with flat bases all at one height IS that level made")
    lp("visible. In the trade winds there is a lid above it as well: the")
    lp(cw("trade inversion",C_ACC) ", warm dry air sinking from above, caps the moist")
    lp("layer the cumulus grow in, and few of them get through it.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="cells"){
    lph("THE HEAT ENGINE, AND THE THREE CELLS")
    lp("The tropics take in more energy from the sun than they radiate away.")
    lp("The poles do the reverse. The atmosphere and the ocean exist, as far as")
    lp("weather is concerned, to move the difference poleward.")
    print ""
    lp("Most of the atmosphere's share travels as " cw("latent heat",C_ACC) " - water")
    lp("evaporated in the tropics and released as rain somewhere else. The")
    lp("water cycle is not a side effect of the weather. It is the working")
    lp("fluid.")
    print ""
    lp("  " cw("Hadley",C_ACC) "    rises at the equator, descends near 30 degrees")
    lp("  " cw("Ferrel",C_ACC) "    30 to 60, and the one you probably sail in")
    lp("  " cw("Polar",C_ACC) "     60 to the pole")
    print ""
    lp("The air descending at 30 degrees has already rained out everything it")
    lp("had, so it arrives warm and dry. That gives you the subtropical highs,")
    lp("the horse latitudes, the trade winds on their equatorward side - and")
    lp("most of the world's deserts sit at that latitude for this reason.")
    print ""
    lp(cw("And it closes the loop with the last lesson:",C_ACC) " that same descending")
    lp("warm air is the trade inversion capping the trade winds' moist layer.")
    lp("The lid over the trade-wind cumulus is the far end of a circulation")
    lp("that started as thunderstorms on the equator.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="h500"){
    lph("THE 500 MILLIBAR CHART, AND THE 564 LINE")
    lp("A 500 mb chart is a " cw("topographic map of a pressure surface",C_ACC) ": the")
    lp("contours are the HEIGHT at which the pressure is 500 millibars, drawn")
    lp("in decametres. So \"564\" means the 5,640 metre contour. Low heights are")
    lp("cold air, high heights are warm.")
    print ""
    lp("It is around 18,000 feet, with about half the atmosphere's mass above")
    lp("and half below - which is why its flow is a fair proxy for where a")
    lp("whole system gets carried. The " cw("steering level",C_ACC) ".")
    print ""
    lp(cw("Five rules a mariner can use from one chart:",C_ACC))
    print ""
    lp("  " cw("1.",C_ACC) " The surface storm track lies " cw("300 to 600 nm poleward",C_ACC) " of the")
    lp("     5640 m contour, and runs " cw("parallel",C_ACC) " to it.")
    print ""
    lp("  " cw("2.",C_ACC) " " cw("All the gale force winds are poleward of the 564 line.",C_WARN))
    lp("     Stay on its equatorward side and you stay out of the gales. This")
    lp("     is the routing rule, and it is why the standard book on the")
    lp("     subject is called Heavy Weather Avoidance.")
    print ""
    lp("  " cw("3.",C_ACC) " Surface lows and fronts move at " cw("a third to a half",C_ACC) " of the")
    lp("     500 mb wind speed above them.")
    print ""
    lp("  " cw("4.",C_ACC) " Surface wind behind the system, in the cold air to the west")
    lp("     and southwest, is about " cw("half",C_ACC) " the 500 mb wind speed.")
    print ""
    lp("  " cw("5.",C_ACC) " Tighter contours mean stronger wind - the upper-air version of")
    lp("     close isobars. And the " cw("588",C_ACC) " contour marks the subtropical ridge,")
    lp("     which is what steers tropical systems.")
    print ""
    lp(cw("You do not need the internet for this.",C_ACC) " A 500 mb chart comes in by HF")
    lp("radiofax, on an SSB receiver, at sea, with no connectivity at all. Read")
    lp("three numbers off it and " cw("weather chart",C_ACC) " will walk the rules with you.")
    print ""
    lpd("From the Mariner's Guide to the 500-Millibar Chart, by Joe Sienkiewicz")
    lpd("of NOAA's Ocean Prediction Center and Lee Chesneau - US Navy, then OPC,")
    lpd("who spent his retirement teaching this to sailors. See docs/SOURCES.md.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="cyclone"){
    lph("HOW A TROPICAL CYCLONE IS MADE, AND HOW TO KEEP AWAY")
    lp("This is the payoff for the other lessons: it needs all of them.")
    print ""
    lp("  " cw("warm deep water",C_ACC) "    about 26.5 C, and 50 m deep, or the storm")
    lp("                     stirs up cold water and kills itself")
    lp("  " cw("enough Coriolis",C_ACC) "    so not within ~5 degrees of the equator")
    lp("  " cw("a moist unstable column",C_ACC) "  moist air is buoyant twice over")
    lp("  " cw("weak wind shear",C_ACC) "    or the tower is torn apart before it organises")
    lp("  " cw("something to start it",C_ACC) "  a wave, a trough, an old front")
    print ""
    lp("Take any one away and you get a lot of rain and no cyclone. Which is")
    lp("useful: it tells you which conditions to worry about.")
    print ""
    lp(cw("AND AVOIDANCE IS A PROBLEM YOU ALREADY KNOW.",C_ACC))
    print ""
    lp("A storm centre has a position, a course and a speed. So do you. You")
    lp("want the largest possible closest point of approach. " cw("That is exactly",C_ACC))
    lp(cw("the relative-motion problem from colregs",C_ACC) " - the same vector triangle,")
    lp("the same bearing drift, the same answer. The dangerous side is just")
    lp("the half where the storm's own motion adds to its wind.")
    print ""
    #  THE CREW'S SHARED WORDS (Larry, TAWG, 18 November 2026): copied as
    #  they stand in the navigationtools design system, "Shared words", so
    #  the lesson, "weather storm", the watch faces and the course say the
    #  same thing.  From Bowditch 2017, chapter 39, pp. 655-659.
    lp(cw("WHICH SIDE YOU ARE ON, IN EITHER HEMISPHERE",C_ACC))
    print ""
    lp("  1. Look the way the storm is going: on its right the wind veers, on")
    lp("     its left it backs.")
    lp("  2. North of the equator its right is the dangerous side; south of")
    lp("     it, its left.")
    lp("  3. A steady shift says " cw("probably",C_ACC) ". A boat under way can see the")
    lp("     opposite shift from her own motion; if in doubt, stop and watch.")
    lp("  4. Face the wind: north of the equator the centre is about 110")
    lp("     degrees to your right ahead of the storm, and 120 to 135 behind")
    lp("     it; south of the equator, to your left. Nearer the centre, a")
    lp("     point or two less.")
    lp("  5. " cw("The navigable side is not safe, only less dangerous.",C_WARN))
    print ""
    lpd("Bowditch, The American Practical Navigator, 2017, chapter 39. Given an")
    lpd("advisory, \"weather storm\" sets these beside your own wind.")
    print ""
    lpd("Which is why the tools in this suite keep turning out to be the same")
    lpd("few ideas wearing different hats.")
    print ""
    return 1
  }
  # ------------------------------------------------------------------
  if(k=="seasons"){
    lph("THE TILT, THE SEASONS, AND AN HONEST BOUNDARY")
    lp("The earth's axis leans " cw("23.5 degrees",C_ACC) " and keeps pointing the same way")
    lp("as it goes round. So each hemisphere leans toward the sun for half the")
    lp("year. That is the whole of the seasons - not distance from the sun,")
    lp("which barely varies and is at its smallest in northern winter.")
    print ""
    lp("At sea you meet it as migration: the whole belt of weather moves north")
    lp("and south with the tilt. The equatorial convergence, the subtropical")
    lp("ridge, the storm tracks. " cw("A cyclone season is a season because the tilt",C_ACC))
    lp(cw("makes it one",C_ACC) " - warm water and a ridge in the right place at once.")
    print ""
    lp(cw("Now the honest part.",C_ACC))
    print ""
    lp("The axis also wobbles, a full circle every 26,000 years, and the orbit")
    lp("stretches and relaxes on cycles of 100,000. Those are real and they")
    lp("drive ice ages.")
    print ""
    lp("They are " cw("climate, not weather",C_ACC) ", and " cw("nothing on your passage depends",C_ACC))
    lp(cw("on them.",C_ACC) " They are in this lesson because they are interesting and")
    lp("because you asked, and they are labelled so you know which is which.")
    print ""
    lpd("Every other lesson here earns its place by changing what you would do.")
    lpd("This half of this one does not, and pretending otherwise would be the")
    lpd("beginning of a tool full of things that sound like knowledge.")
    print ""
    return 1
  }
  return 0
}
function lesson_q(k){
  if(k=="fluid")    return "It is 30 C and very humid. Is that air heavier or lighter than 30 C and dry?|Lighter. Water molecules at 18 replace nitrogen at 28 and oxygen at 32, and a given volume holds a fixed number of molecules. Warm and wet is buoyant twice over, which is what builds thunderstorms."
  if(k=="data")     return "The latest surface analysis and a GRIB's forecast for the same hour put the low in different places. Which do you believe?|The analysis. Forecasters drew it from the observations and used the model only where other evidence agreed. The GRIB is the model's numbers, which no forecaster has checked, and the further ahead of its run time it reads, the less it is worth."
  if(k=="runs")     return "A GRIB says: run 18Z 23 May, step 33. What hour does it describe, and what is that on the boat's clock in the Channel?|03:00 UTC on 25 May: 18:00 plus 33 hours. In May that is 04:00 British Summer Time. The run of 00Z 24 May at step 27 describes the same hour from six hours later and less far ahead, so if you hold both, the newer one is likely the better."
  if(k=="models")   return "Five days before the start, a 1.5 km model shows a fine sea breeze on race day. Do you plan on it?|Not yet. Five days out is for the big picture, from the global models: which systems, and whether their story holds run after run. A sea breeze is local detail, and a high-resolution model cannot know the synoptic story better than the global model at its edges. Look at it again on race morning, for the coast."
  if(k=="routing")  return "The router sends you to the far right-hand corner, for a gain of four minutes over the middle. What do you ask before you sail it?|What it loses if the forecast is wrong. The router goes all in for any gain, however small: it measures time, never risk. Route it again with the wind lighter and stronger, on the next run and on another model. If the corner loses half an hour when the shift is late or goes the other way, and the middle loses four minutes when the forecast is right, the middle is the route."
  if(k=="tide")     return "You are at 12N. The glass has fallen 2 hPa between 1000 and 1600. Worry?|Probably not - that is very close to the daily atmospheric tide, which is about 1.4 hPa of semidiurnal swing in the tropics with a minimum near 1600. Correct for it before reading anything into it. At 50N the same fall would mean much more."
  if(k=="coriolis") return "Why does no hurricane ever form on the equator?|Coriolis goes as sin(latitude) and is zero there. All the heat and moisture in the world, and nothing to start it rotating. About 5 degrees is the practical minimum."
  if(k=="gradient") return "The chart shows a 30 knot gradient wind. What do you expect on deck, offshore, in the northern hemisphere?|Around 20 knots - roughly two thirds - and backed 10 to 20 degrees from the isobar direction, because friction slows the surface air, which weakens Coriolis, so pressure gradient wins a little and the wind blows across the isobars toward the low."
  if(k=="veer")     return "Off the Isle of Wight the wind goes from south-west to west to north-west over six hours, and the glass starts to rise. Backed or veered - and where did the low go?|Veered: it shifted clockwise round the compass. In the northern hemisphere that is a depression whose centre has passed on your north side, and the shift to north-west with a rising glass says the cold front is through."
  if(k=="fronts")   return "Off Start Point the glass has been falling for six hours. Mares' tails became a grey sheet, and now it is raining steadily with the wind at south. What comes next, and which way will the wind go?|The warm front is close. When it passes the rain stops, the wind veers to south-west and it turns warm and muggy, with drizzle or fog and a steady glass: the warm sector. Then the cold front: squalls and heavy showers, the wind veering to north-west, the glass rising and the air clearing. If instead the wind backs steadily, the centre is passing on your south side and the fronts will miss you."
  if(k=="lapse")    return "Air 18 C, dew point 12 C. How high is the cloud base?|About 2,400 ft: a spread of 6 C, and the spread closes at 2.5 C per 1000 ft, so 6 x 400. Not 6 x 333 - the divisor is the DIFFERENCE between the parcel's lapse rate and the dew point's, not the lapse rate itself."
  if(k=="cells")    return "Why are so many of the world's deserts near 30 degrees latitude?|That is where the Hadley cell descends. The air rose at the equator, rained out everything it had, and comes back down warm and dry. The subtropical highs, the horse latitudes and the deserts are all the same descending branch."
  if(k=="h500")     return "The 564 line runs east-west 200 nm north of you. Where is the storm track, and are you in the gales?|The track is 300 to 600 nm poleward of the 564 line and parallel to it, so well north of you. And all the gale force winds are poleward of that line - so at 200 nm south of it you are on the right side of it. That is the routing rule."
  if(k=="cyclone")  return "Sea surface 27 C, moist unstable air, a nice tropical wave - and 40 knots of shear aloft. Cyclone?|No. Shear tears the tower apart before it can organise. Four of the five ingredients is not a storm, which is exactly why knowing the list is useful."
  if(k=="seasons")  return "Northern winter is when the earth is CLOSEST to the sun. So why is it cold?|Because the seasons are the 23.5 degree tilt, not the distance. The northern hemisphere is leaning away, so the sun is low, the days are short, and the same energy is spread over more ground. The distance varies by about 3 percent and is swamped by it."
  return ""
}

# =====================================================================
#  A SECOND TIER.  Each lesson stays short enough to read on a pitching
#  boat; the deeper material sits behind a prompt, for the reader who
#  wants to know why and not only what.  Same rule as the lessons
#  themselves: it has to change what the app says or what you would do.
# =====================================================================
function les_has_more(k){
  return (k=="coriolis")
}

function lesson_more(k){
  if(k=="coriolis"){
    lph("FROM OUTSIDE, IT IS ANGULAR MOMENTUM")
    lp("Stand off the planet and watch. In that frame nothing curves and")
    lp("nothing is pushing. What is conserved is " cw("angular momentum",C_ACC))
    lp("about the earth's axis.")
    print ""
    lp("A point at latitude L sits " cw("a cos L",C_ACC) " from the axis, so the ground")
    lp("there is already running east at:")
    print ""
    lp("  equator        1,674 km/h")
    lp("  30 degrees     1,450")
    lp("  45 degrees     1,184")
    lp("  60 degrees       837")
    lp("  " cw("pole               0",C_ACC))
    print ""
    lp("A shell in flight feels almost no torque about that axis - drag")
    lp("aside, gravity acts straight at the centre - so its own")
    lp(cw("u x r",C_ACC) " is fixed. Carry it closer to the axis and it must run")
    lp("faster east; carry it further out and it must run slower.")
    print ""
    lph("TWO SHELLS, FIRED NORTH AND FIRED SOUTH")
    lp("  " cw("fired    distance from axis   ground below      the shell",C_ACC))
    lp("  north    shrinks              east SLOWER       outruns it")
    lp("  south    grows                east FASTER       lags it")
    print ""
    #  THE PICTURE GOES HERE, between the table that states the mechanism
    #  and the sentence that states the punchline, because the punchline is
    #  the part a reader doubts: "both deflect right" reads as a
    #  contradiction until you see one shell go east and the other west in
    #  the same drawing.
    gun_figure()
    gshow()
    print ""
    lpd("The curve is a parabola because the sideways acceleration is steady")
    lpd("along the track, so the offset goes as the SQUARE of the time of")
    lpd("flight. Its SIZE here is scaled to the width of the picture; the real")
    lpd("figure is two paragraphs down, and it is small.")
    print ""
    lp("Fired north it lands EAST of the aim. Fired south it lands WEST.")
    lp("Going north, east is to your right. Going south, west is to your")
    lp("right. " cw("Both deflect right",C_ACC) " - and in the southern hemisphere")
    lp("both deflect left. That is Coriolis, with no force anywhere in it.")
    print ""
      lp("The size is real and small, and it takes BOTH halves of the story.")
      lp("A 16 inch shell at full range - 38 km, about 90 seconds of flight -")
      lp("ends up 27 km nearer the axis. The ground there runs 7 km/h slower")
      lp("east; the shell itself runs 7 km/h faster to keep " cw("u x r",C_ACC) ". So it")
      lp("arrives " cw("14 km/h",C_ACC) " ahead of the ground, not 7, and since that excess")
      lp("grows from nothing the offset is the mean of it: about " cw("175 metres",C_ACC) ".")
      print ""
      lpd("Checked the other way, which is the form a textbook gives: the")
      lpd("sideways acceleration is 2 x Omega x v x sin(latitude), here 0.044")
      lpd("m/s2, and half of that times ninety seconds squared is the same")
      lpd("175 metres. Counting only the ground slowing, and forgetting that")
      lpd("the shell speeds up, halves the answer - which is the easiest")
      lpd("mistake to make here, because the first half is the memorable one.")
    print ""
    lph("FIRED EAST OR WEST, THE MOMENTUM STORY RUNS OUT")
    lp("Everything above is about changing your DISTANCE FROM THE AXIS, so")
    lp("it explains a shot fired north or south and says nothing at all")
    lp("about one fired east or west - which does not change that distance.")
    lp("Yet an east shot gets the same " cw("175 metre",C_ACC) " sideways push. That looks")
    lp("like a contradiction and it is not: it is a " cw("second mechanism",C_ACC) " that")
    lp("happens to give the same answer.")
    print ""
    lp("Fire east and you are now going round the axis FASTER than the")
    lp("ground is. A faster circle needs more centripetal force than")
    lp("gravity was already supplying, and what it does not get, it loses")
    lp("as an outward push. The push is " cw("away from the EARTH'S AXIS",C_ACC) " - not")
    lp("away from the centre, and not straight up.")
    print ""
    lp("And that is the whole answer, because at latitude L the direction")
    lp("away from the axis is tilted. It points:")
    print ""
    lp("  up                   by cos L")
    lp("  toward the equator   by sin L")
    print ""
    lp("One push, resolved two ways. The equatorward part is an ordinary")
    lp("sideways deflection - south, which fired east is to your right -")
    lp("and it is " cw("2 x Omega x u x sin L",C_ACC) ", the same size as before. The")
    lp("upward part reduces the shell's apparent weight, and that is the")
    lp(cw("Eotvos effect",C_ACC) ".")
    print ""
    lpd("Checkable, and it checks exactly: for purely eastward motion the")
    lpd("Coriolis acceleration is 2 x Omega x u at EVERY latitude, and its")
    lpd("direction is the axis-outward unit vector (0, -sin L, cos L) in")
    lpd("east-north-up to twelve decimal places. The two famous components")
    lpd("are not two effects. They are one vector's two shadows.")
    print ""
    lp("The symmetry is worth holding on to. The sideways part goes as")
    lp("sin L and the vertical part as cos L, so they trade places:")
    print ""
    lp("  on the equator   away from the axis is STRAIGHT UP")
    lp("                   no sideways deflection, Eotvos at its largest")
    lp("  at the pole      away from the axis is HORIZONTAL")
    lp("                   all sideways deflection, no Eotvos at all")
    print ""
    lp("A shell does not stay up to enjoy its lost weight, so the thing you")
    lp("measure is not height but " cw("RANGE",C_ACC) ". Lighter, it hangs on past the")
    lp("moment it should have landed: at 45 N our 16 inch shell carries")
    lp(cw("169 metres further",C_ACC) " fired east and 169 metres short fired west.")
    lp("Due north or south, nothing - there is no east component to act on.")
    print ""
    lph("AND THE SHELL'S OWN CLIMB AND FALL")
    lp("One more, and it is the one nobody mentions. The same cos L term")
    lp("acts on the shell's VERTICAL speed, east-west:")
    print ""
    lp("  climbing   pushed west")
    lp("  falling    pushed east")
    print ""
    lp("Those do not cancel. The shell spends the whole flight above the")
    lp("ground, so the westward push acts on a rising shell for the first")
    lp("half and the eastward push on a falling one for the second, and")
    lp("what survives is the time the shell spent up there at all. For a")
    lp("90 second flight it is about " cw("61 metres to the west",C_ACC) ", whichever way")
    lp("the gun is trained.")
    print ""
    lpd("It is the same physics as the eastward deflection of a dropped")
    lpd("stone, with the climb run backwards. And note what it does NOT do:")
    lpd("cos L is positive on both sides of the equator, so unlike the other")
    lpd("two this term does not reverse with hemisphere. The southern")
    lpd("hemisphere is therefore not quite the mirror of the northern.")
    print ""
    lph("THE THREE, AND WHAT THE GUN CAPTAIN CORRECTS")
    lp("A 16 inch shell, 38 km, 90 seconds, from 45 N:")
    print ""
    lp("  turning with the earth    176 m right    any bearing")
    lp("  the Eotvos effect         169 m range    east-west only")
    lp("  its own climb and fall     61 m west     any bearing")
    print ""
    lpd("The 175 above and the 176 here are the same quantity; the first")
    lpd("came from speeds rounded to whole km/h.")
    print ""
    lp("Which add up, by bearing, to two corrections:")
    print ""
    lp("  fired      across the track      along it")
    lp("  north      115 m right           -")
    lp("  east       176 m right           107 m long")
    lp("  south      238 m right           -")
    lp("  west       176 m right           107 m short")
    print ""
    lp("So the deflection is NOT the same at every bearing after all - the")
    lp("turning term is, and the climb-and-fall term adds to it going south")
    lp("and subtracts going north. " cw("Both still deflect right",C_ACC) ", which is the")
    lp("lesson; they do not deflect right by the same amount.")
    print ""
    lpd("All three are first-order, in vacuum, over a flat earth - the same")
    lpd("idealisation as the 38 km in 90 seconds. Air resistance makes the")
    lpd("climb and the fall unequal and moves the third figure in")
    lpd("particular. Real firing tables are built from measurement.")
    print ""
    lpd("ONE THING THIS DOES NOT TOUCH: the wind. Air moving horizontally")
    lpd("has no vertical speed worth the name and no east-west component")
    lpd("going round the axis fast enough to matter, so of the three only")
    lpd("the turning term applies to it. Everything below stands.")
    print ""
    lpd("Not to be confused with DRIFT, which in gunnery means the sideways")
    lpd("deviation from the shell's own spin on a rifled barrel. Long range")
    lpd("tables correct for both. They are different things with different")
    lpd("causes, and only one of them reverses with hemisphere.")
    print ""
    lph("AND NOW THE WIND")
    lp("Pressure pushes air from the high toward the low. The instant it")
    lp("moves, the same bookkeeping turns it right, so it never runs")
    lp("straight down the gradient. It ends up going " cw("around",C_ACC) ":")
    print ""
    lp("  northern hemisphere   anticlockwise around a low")
    lp("                        clockwise around a high")
    lp("  " cw("southern hemisphere   both the other way",C_ACC))
    print ""
    lp("Friction is what turns circling into weather. At the surface the")
    lp("air is slowed, feels less deflection, and pressure wins a little,")
    lp("so the flow spirals " cw("IN to a low",C_ACC) " and " cw("OUT of a high",C_ACC) ":")
    print ""
    lp("  in   ->  convergence  ->  air must rise  ->  cloud, and rain")
    lp("  out  ->  divergence   ->  air must sink  ->  clearing, and dry")
    print ""
    lp("That is why a low is wet and a high is dry. It is the same friction")
    lp("that puts twist in a sail - see " cw("gradient",C_ACC) " for the numbers.")
    print ""
    lph("HOW FAR ACROSS, AND WHAT DOES NOT CHANGE IT")
    lp("With a drag that goes as the wind, the balance solves exactly:")
    print ""
    lp("  " cw("tan(alpha) = k / f",C_ACC) "       speed / gradient = cos(alpha)")
    print ""
    lp("and the " cw("pressure gradient cancels out of the angle",C_ACC) ". A deeper low")
    lp("gives you more wind at the same angle, not a straighter wind.")
    print ""
    lp("That is worth dwelling on, because the opposite is the intuitive")
    lp("answer: surely a hard blow is dragged round into the isobars? No -")
    lp("and with the quadratic drag water really has, the angle " cw("GROWS",C_ACC))
    lp("with the wind. The strongest lows on earth have the largest inflow")
    lp("angles: a hurricane's boundary layer runs 20 to 30 degrees of it.")
    print ""
    lp("Nor can centrifugal force be the reason, because in a frictionless")
    lp("balance the wind " cw("already follows the isobars exactly",C_ACC) ", at every")
    lp("gradient and every latitude. There is nothing for it to improve.")
    print ""
    lp("What does set the angle is the surface you are over, and " cw("latitude",C_ACC) ".")
    lp("Take 15 degrees over water at 45 N and carry the same drag north")
    lp("and south:")
    print ""
    lp("  " cw("latitude   over water   over land",C_ACC))
    lp("  10            48            71")
    lp("  20            29            55")
    lp("  30            21            45")
    lp("  45            15            35")
    lp("  60            12            30")
    lp("  75            11            27")
    print ""
    lp("Near the equator the air pours almost straight down the gradient")
    lp("into the low. At high latitude it nearly follows the isobars. Same")
    lp("physics as the two shells: less sin(latitude), less turning.")
    print ""
    wind_figure(45, 15, 1)
    gshow()
    print ""
    lph("AND THE CENTRIFUGAL TERM CHANGES THE SPEED")
    lp("Round a low it points outward, so it ADDS to Coriolis against the")
    lp("pressure gradient and the wind comes out " cw("below",C_ACC) " geostrophic. Round")
    lp("a high it subtracts, and the wind runs above it. One isobar")
    lp("spacing, 4 mb in 100 km at 45 N, which is 62 knots geostrophic:")
    print ""
    lp("  " cw("curvature    round a low   round a high",C_ACC))
    lp("  2000 km         54 kn         76 kn")
    lp("  1000 km         49 kn         " cw("impossible",C_WARN))
    lp("   500 km         43 kn         " cw("impossible",C_WARN))
    lp("   250 km         36 kn         " cw("impossible",C_WARN))
    print ""
    lp("That word is the arithmetic, not a shrug. For a high the balance")
    lp("needs f squared R to be at least 4G, and past that there is " cw("no",C_ACC))
    lp(cw("solution at all",C_ACC) " - no wind can hold that pressure field up. So a")
    lp("deep tight low is ordinary and a tight intense high does not exist,")
    lp("which is why every chart you have ever read looks the way it does.")
    print ""
    lpd("And the limit tightens as you go equatorward, because it goes as f")
    lpd("squared. At 1000 km of curvature the steepest high that can exist")
    lpd("is 6.1 mb per 100 km at 75 degrees, 3.3 at 45, and 0.2 at 10. The")
    lpd("tropics get their weather from lows for a reason.")
    print ""
    lpd("Honest boundary: these are steady-state balances with a drag law")
    lpd("fitted to an observed angle, not a boundary-layer model. The 10")
    lpd("metre wind is lower again than cos(alpha) says, because most of")
    lpd("that reduction is shear between the anemometer and the gradient")
    lpd("level rather than the balance above.")
    print ""
    return 1
  }
  return 0
}
# =====================================================================
#  weather -- dispatch
# =====================================================================
BEGIN{
  col_init(); les_init()

  if(cmd=="version"){ print "weather engine"; exit 0 }

  else if(cmd=="what"){ wx_report(LOG, lon, hours+0, seaclose) }
  else if(cmd=="score"){ sc_report(LOG) }
  else if(cmd=="chart"){ ch_report(brg, dist, orient, w500, (north==""?1:north+0)) }
  else if(cmd=="isobars"){ iso_report(spacing, lat, step, (north==""?1:north+0)) }
  else if(cmd=="frontsdump"){ fr_dump() }
  else if(cmd=="routedump"){ rt_dump() }
  else if(cmd=="storm"){ st_report(age, clat, clon, mdir, mkn, r34, blat, blon, bcse, bkn, wind) }

  else if(cmd=="syllabus"){
    print ""
    printf "  %s\n", cw("LESSONS", C_ACC)
    hr()
    for(i=1;i<=LS_N;i++){
      mk = (index("," donelist ",", "," LS_K[i] ",")>0) ? "*" : " "
      printf "   %s %-9s %s\n", mk, LS_K[i], LS_T[i]
    }
    hr()
    printf "  %s\n", cwd("* = done.    weather learn <key>")
    print ""
    printf "  %s\n", cwd("Each one earns its place by changing what the app says or what")
    printf "  %s\n", cwd("you would do. One of them says plainly where that stops being")
    printf "  %s\n", cwd("true, which is the point of the rule.")
    print ""
  }
  else if(cmd=="lesson"){
    if(!lesson_body(key)){ printf "  no such lesson: %s\n", key; exit 2 }
    n=split(lesson_q(key),QA,"|")
    if(n>=1){ hr(); printf "  %s %s\n", cw("Question:",C_ACC), QA[1]; print "" }
  }
  else if(cmd=="lessonq"){ n=split(lesson_q(key),QA,"|"); if(n>=2) print QA[2] }
  #  the second tier: the deeper section, and whether one exists at all
  else if(cmd=="lessonmore"){
    if(!lesson_more(key)){ printf "  no deeper section for: %s\n", key; exit 2 }
  }
  else if(cmd=="lessonhasmore"){ exit (les_has_more(key) ? 0 : 1) }
  else if(cmd=="lessonlist"){ for(i=1;i<=LS_N;i++) print LS_K[i] }

  #  the machine forecasts, built only after the user's is committed
  else if(cmd=="fcast"){
    n = wx_load(LOG)
    if(n<1) exit 1
    for(i=n-1;i>=1;i--) if(wx_has(WP[i]) && wx_has(WP[n])) break
    k=i
    if(who2=="persist") sc_persist(n); else sc_rules(n, k, hours+0, lon)
    if(wx_has(F_WDIR)) printf "wdir=%d\n", (F_WDIR+0.5)
    if(wx_has(F_WSPD)) printf "wspd=%.0f\n", F_WSPD
    if(wx_has(F_MSLP)) printf "mslp=%.1f\n", F_MSLP
    if(wx_has(F_SEA))  printf "sea=%d\n",   F_SEA
    printf "why=%s\n", (F_WHY==""?"-":F_WHY)
  }
  else if(cmd=="validat"){ print sc_validtime(now, hours+0) }
  else if(cmd=="mkrec"){
    n=0
    while((getline line < fields) > 0){
      p = index(line, "\t"); if(p<2) continue
      K[++n]=substr(line,1,p-1); V[n]=substr(line,p+1)
    }
    close(fields)
    rec = lg_make(now, type, K, V, n)
    if(!lg_parse(rec)) exit 2
    print rec
  }
  else { printf "  weather: unknown cmd %s\n", cmd; exit 2 }
}
#__BN_END_ENGINE__
